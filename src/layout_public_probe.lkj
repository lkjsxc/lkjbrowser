//! Offline renderer for cached public HTML; never opens network sockets.
//! Usage: layout-public-probe INPUT.html OUTPUT_BASE [SCROLL_Y] [STYLESHEET.css ...]
//! Content viewport matches the 1000x760 browser window: 988x662.
mod html;
mod css;
mod font;
mod layout;
mod paint;
mod png;

fn read(world:&mut World,path:&str)->Vec<u8>{
    let (root,name)=match path.rfind('/'){Some(i)=>if i==0usize{("/", &path[1..])}else{(&path[..i], &path[i+1usize..])},None=>(".",path)};
    let mut dir=world.directory(root).unwrap();let mut file=dir.open_regular(name).unwrap();
    let mut bytes=Vec::new();let mut buf=[0u8;8192];
    loop{let n=file.read(&mut buf).unwrap();if n==0usize{break;}assert!(bytes.len()+n<=2097152usize);bytes.extend_from_slice(&buf[..n]);}
    bytes
}
fn write(world:&mut World,path:&str,bytes:&[u8]){
    let (root,name)=match path.rfind('/'){Some(i)=>if i==0usize{("/", &path[1..])}else{(&path[..i], &path[i+1usize..])},None=>(".",path)};
    let mut dir=world.directory(root).unwrap();let mut file=dir.create(name).unwrap();file.write_all(bytes).unwrap();
}
fn main(mut world:World){
    let args=world.args();assert!(args.len()>=2usize);
    let input=std::str::from_utf8(&args[0]).unwrap().to_string();
    let output=std::str::from_utf8(&args[1]).unwrap().to_string();
    let scroll=if args.len()>2usize{std::str::from_utf8(&args[2]).unwrap().parse::<i32>().unwrap()}else{0i32};
    let bytes=read(&mut world,input.as_str());let source=std::str::from_utf8(&bytes).unwrap();
    let mut doc=html::parse(source);
    let mut sheets=String::new();let mut sheet=3usize;
    while sheet<args.len(){let path=std::str::from_utf8(&args[sheet]).unwrap();let bytes=read(&mut world,path);sheets.push_str(std::str::from_utf8(&bytes).unwrap());sheets.push_str("\n");sheet+=1usize;}
    sheets.push_str(doc.styles.as_str());doc.styles=sheets;
    let mut normal=font::Font::parse(read(&mut world,"/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf")).unwrap();
    let mut bold=font::Font::parse(read(&mut world,"/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf")).unwrap();
    let mut italic=font::Font::parse(read(&mut world,"/usr/share/fonts/truetype/liberation/LiberationSans-Italic.ttf")).unwrap();
    let mut bolditalic=font::Font::parse(read(&mut world,"/usr/share/fonts/truetype/liberation/LiberationSans-BoldItalic.ttf")).unwrap();
    let page=layout::build_in_viewport(&doc,988,1000,662,&normal,&bold,&italic,&bolditalic);
    let mut canvas=paint::Canvas::new(988usize,662usize,page.background);
    for command in &page.commands{
        match command{
            layout::Command::Rect(r)=>canvas.rect(r.x,r.y-scroll,r.width,r.height,r.color),
            layout::Command::Text(run)=>{
                if run.baseline+run.size-scroll>0 && run.top-scroll<662{
                    let face=if run.bold && run.italic{&mut bolditalic}else if run.bold{&mut bold}else if run.italic{&mut italic}else{&mut normal};
                    canvas.text(face,run.text.as_str(),run.size,run.x,run.baseline-scroll,run.color);
                }
            },
            layout::Command::Image(im)=>{
                canvas.rect(im.x,im.y-scroll,im.width,im.height,0xe6eef0u32);
                if im.y-scroll+28>0 && im.y-scroll<662{canvas.text(&mut normal,im.alt.as_str(),15,im.x+12,im.y-scroll+28,0x54717du32);}
            },
        }
    }
    write(&mut world,format!("{}.png",output).as_str(),&png::encode(988usize,662usize,&canvas.pixels).unwrap());
    write(&mut world,format!("{}.layout",output).as_str(),page.dump().as_bytes());
    world.stdout().write(format!("Offline page: {} height={} commands={} scroll={}\n",input,page.height,page.commands.len(),scroll).as_bytes());
}
