mod bigint;mod sha512;mod signature;
fn hx(s:&str)->Vec<u8>{let mut out=Vec::new();let b=s.as_bytes();let mut i=0usize;while i<b.len(){let a=if b[i]<=b'9'{b[i]-b'0'}else{b[i].to_ascii_lowercase()-b'a'+10u8};let c=if b[i+1usize]<=b'9'{b[i+1usize]-b'0'}else{b[i+1usize].to_ascii_lowercase()-b'a'+10u8};out.push(a*16u8+c);i+=2usize;}out}
pub fn main(mut world:World){let mut clock=world.clock();
{let n=hx("");let e=hx("010001");let s=hx("");let m=hx("6c6b6a62726f77736572207075626c6963207369676e617475726520766572696669636174696f6e20666978747572652076310a");let start=clock.nanoseconds().unwrap();let mut i=0usize;while i<10usize{signature::verify_rsa(&n,&e,&s,&m,256u16,true).unwrap();i+=1usize;}let ns=clock.nanoseconds().unwrap()-start;world.stdout().write(format!("RSA2048-PSS-SHA256 mean_ns={}\n",ns/10usize).as_bytes());}
{let n=hx("");let e=hx("010001");let s=hx("");let m=hx("6c6b6a62726f77736572207075626c6963207369676e617475726520766572696669636174696f6e20666978747572652076310a");let start=clock.nanoseconds().unwrap();let mut i=0usize;while i<10usize{signature::verify_rsa(&n,&e,&s,&m,256u16,true).unwrap();i+=1usize;}let ns=clock.nanoseconds().unwrap()-start;world.stdout().write(format!("RSA3072-PSS-SHA256 mean_ns={}\n",ns/10usize).as_bytes());}
{let n=hx("");let e=hx("010001");let s=hx("");let m=hx("6c6b6a62726f77736572207075626c6963207369676e617475726520766572696669636174696f6e20666978747572652076310a");let start=clock.nanoseconds().unwrap();let mut i=0usize;while i<10usize{signature::verify_rsa(&n,&e,&s,&m,256u16,true).unwrap();i+=1usize;}let ns=clock.nanoseconds().unwrap()-start;world.stdout().write(format!("RSA4096-PSS-SHA256 mean_ns={}\n",ns/10usize).as_bytes());}
{let k=hx("0460FED4BA255A9D31C961EB74C6356D68C049B8923B61FA6CE669622E60F29FB67903FE1008B8BC99A41AE9E95628BC64F2F1B20C2D7E9F5177A3C294D4462299");let s=hx("3046022100efd48b2aacb6a8fd1140dd9cd45e81d69d2c877b56aaf991c34d0ea84eaf3716022100f7cb1c942d657c41d436c7a1b6e29f65f3e900dbb9aff4064dc4ab2f843acda8");let start=clock.nanoseconds().unwrap();let mut i=0usize;while i<10usize{signature::verify_ecdsa(23u16,&k,&s,b"sample",256u16).unwrap();i+=1usize;}let ns=clock.nanoseconds().unwrap()-start;world.stdout().write(format!("P256-SHA256 mean_ns={}\n",ns/10usize).as_bytes());}
{let k=hx("04EC3A4E415B4E19A4568618029F427FA5DA9A8BC4AE92E02E06AAE5286B300C64DEF8F0EA9055866064A254515480BC138015D9B72D7D57244EA8EF9AC0C621896708A59367F9DFB9F54CA84B3F1C9DB1288B231C3AE0D4FE7344FD2533264720");let s=hx("306602310094edbb92a5ecb8aad4736e56c691916b3f88140666ce9fa73d64c4ea95ad133c81a648152e44acf96e36dd1e80fabe4602310099ef4aeb15f178cea1fe40db2603138f130e740a19624526203b6351d0a3a94fa329c145786e679e7b82c71a38628ac8");let start=clock.nanoseconds().unwrap();let mut i=0usize;while i<10usize{signature::verify_ecdsa(24u16,&k,&s,b"sample",384u16).unwrap();i+=1usize;}let ns=clock.nanoseconds().unwrap()-start;world.stdout().write(format!("P384-SHA384 mean_ns={}\n",ns/10usize).as_bytes());}
}
