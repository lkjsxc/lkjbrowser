//! AES-128-GCM, 96-bit nonces and full 128-bit tags, per FIPS 197 / SP 800-38D.
//! This is a reusable source implementation, not a foreign crypto binding.
//! AES's S-box uses secret-indexed memory. No constant-time claim is made.
//! Decryption authenticates the ciphertext before producing any plaintext.
const SBOX:[u8;256]=[
0x63u8,0x7cu8,0x77u8,0x7bu8,0xf2u8,0x6bu8,0x6fu8,0xc5u8,0x30u8,0x01u8,0x67u8,0x2bu8,0xfeu8,0xd7u8,0xabu8,0x76u8,
0xcau8,0x82u8,0xc9u8,0x7du8,0xfau8,0x59u8,0x47u8,0xf0u8,0xadu8,0xd4u8,0xa2u8,0xafu8,0x9cu8,0xa4u8,0x72u8,0xc0u8,
0xb7u8,0xfdu8,0x93u8,0x26u8,0x36u8,0x3fu8,0xf7u8,0xccu8,0x34u8,0xa5u8,0xe5u8,0xf1u8,0x71u8,0xd8u8,0x31u8,0x15u8,
0x04u8,0xc7u8,0x23u8,0xc3u8,0x18u8,0x96u8,0x05u8,0x9au8,0x07u8,0x12u8,0x80u8,0xe2u8,0xebu8,0x27u8,0xb2u8,0x75u8,
0x09u8,0x83u8,0x2cu8,0x1au8,0x1bu8,0x6eu8,0x5au8,0xa0u8,0x52u8,0x3bu8,0xd6u8,0xb3u8,0x29u8,0xe3u8,0x2fu8,0x84u8,
0x53u8,0xd1u8,0x00u8,0xedu8,0x20u8,0xfcu8,0xb1u8,0x5bu8,0x6au8,0xcbu8,0xbeu8,0x39u8,0x4au8,0x4cu8,0x58u8,0xcfu8,
0xd0u8,0xefu8,0xaau8,0xfbu8,0x43u8,0x4du8,0x33u8,0x85u8,0x45u8,0xf9u8,0x02u8,0x7fu8,0x50u8,0x3cu8,0x9fu8,0xa8u8,
0x51u8,0xa3u8,0x40u8,0x8fu8,0x92u8,0x9du8,0x38u8,0xf5u8,0xbcu8,0xb6u8,0xdau8,0x21u8,0x10u8,0xffu8,0xf3u8,0xd2u8,
0xcdu8,0x0cu8,0x13u8,0xecu8,0x5fu8,0x97u8,0x44u8,0x17u8,0xc4u8,0xa7u8,0x7eu8,0x3du8,0x64u8,0x5du8,0x19u8,0x73u8,
0x60u8,0x81u8,0x4fu8,0xdcu8,0x22u8,0x2au8,0x90u8,0x88u8,0x46u8,0xeeu8,0xb8u8,0x14u8,0xdeu8,0x5eu8,0x0bu8,0xdbu8,
0xe0u8,0x32u8,0x3au8,0x0au8,0x49u8,0x06u8,0x24u8,0x5cu8,0xc2u8,0xd3u8,0xacu8,0x62u8,0x91u8,0x95u8,0xe4u8,0x79u8,
0xe7u8,0xc8u8,0x37u8,0x6du8,0x8du8,0xd5u8,0x4eu8,0xa9u8,0x6cu8,0x56u8,0xf4u8,0xeau8,0x65u8,0x7au8,0xaeu8,0x08u8,
0xbau8,0x78u8,0x25u8,0x2eu8,0x1cu8,0xa6u8,0xb4u8,0xc6u8,0xe8u8,0xddu8,0x74u8,0x1fu8,0x4bu8,0xbdu8,0x8bu8,0x8au8,
0x70u8,0x3eu8,0xb5u8,0x66u8,0x48u8,0x03u8,0xf6u8,0x0eu8,0x61u8,0x35u8,0x57u8,0xb9u8,0x86u8,0xc1u8,0x1du8,0x9eu8,
0xe1u8,0xf8u8,0x98u8,0x11u8,0x69u8,0xd9u8,0x8eu8,0x94u8,0x9bu8,0x1eu8,0x87u8,0xe9u8,0xceu8,0x55u8,0x28u8,0xdfu8,
0x8cu8,0xa1u8,0x89u8,0x0du8,0xbfu8,0xe6u8,0x42u8,0x68u8,0x41u8,0x99u8,0x2du8,0x0fu8,0xb0u8,0x54u8,0xbbu8,0x16u8];
fn xtime(x:u8)->u8{(x<<1usize)^(0x1bu8&(0u8.wrapping_sub(x>>7usize)))}
fn schedule(key:&[u8])->[u8;176]{
    let sbox=SBOX;
    let mut keys=[0u8;176];keys[..16].copy_from_slice(key);
    let mut at=16usize;let mut rc=1u8;
    while at<176usize{
        let mut w=[keys[at-4usize],keys[at-3usize],keys[at-2usize],keys[at-1usize]];
        if at%16usize==0usize{w=[sbox[w[1] as usize]^rc,sbox[w[2] as usize],sbox[w[3] as usize],sbox[w[0] as usize]];rc=xtime(rc);}
        let mut i=0usize;while i<4usize{keys[at]=keys[at-16usize]^w[i];at+=1usize;i+=1usize;}
    }
    keys
}
fn block(keys:&[u8;176],input:&[u8;16])->[u8;16]{
    let sbox=SBOX;
    let mut state=*input;let mut i=0usize;while i<16usize{state[i]^=keys[i];i+=1usize;}
    let mut round=1usize;
    while round<=10usize{
        let mut shifted=[0u8;16];let mut c=0usize;
        while c<4usize{let mut row=0usize;while row<4usize{shifted[4usize*c+row]=sbox[state[4usize*((c+row)%4usize)+row] as usize];row+=1usize;}c+=1usize;}
        state=shifted;
        if round<10usize{
            c=0usize;while c<4usize{
                let p=4usize*c;let a=state[p];let b=state[p+1usize];let d=state[p+2usize];let e=state[p+3usize];
                let all=a^b^d^e;
                state[p]=a^all^xtime(a^b);state[p+1usize]=b^all^xtime(b^d);
                state[p+2usize]=d^all^xtime(d^e);state[p+3usize]=e^all^xtime(e^a);c+=1usize;
            }
        }
        i=0usize;while i<16usize{state[i]^=keys[16usize*round+i];i+=1usize;}round+=1usize;
    }
    state
}
pub fn encrypt_block(key:&[u8],input:&[u8])->Result<Vec<u8>,String>{
    if key.len()!=16usize || input.len()!=16usize{return Err("AES-128 requires a 16-byte key and block".to_string());}
    let keys=schedule(key);let mut plain=[0u8;16];plain[..].copy_from_slice(input);
    let output=block(&keys,&plain);Ok(output[..].to_vec())
}
fn be64(input:&[u8],start:usize)->u64{
    let mut value=0u64;let mut i=0usize;while i<8usize{value=(value<<8usize)|(input[start+i] as u64);i+=1usize;}value
}
fn put64(out:&mut [u8],start:usize,value:u64){
    let mut i=0usize;while i<8usize{out[start+i]=(value>>((7usize-i)*8usize)) as u8;i+=1usize;}
}
fn gf128(xhi:u64,xlo:u64,mut yhi:u64,mut ylo:u64)->(u64,u64){
    let mut zhi=0u64;let mut zlo=0u64;let mut i=0usize;
    while i<128usize{
        let bit=if i<64usize{(xhi>>(63usize-i))&1u64}else{(xlo>>(127usize-i))&1u64};
        let mask=0u64.wrapping_sub(bit);zhi^=yhi&mask;zlo^=ylo&mask;
        let bottom=ylo&1u64;ylo=(ylo>>1usize)|(yhi<<63usize);yhi=(yhi>>1usize)^(0xe100000000000000u64&(0u64.wrapping_sub(bottom)));i+=1usize;
    }
    (zhi,zlo)
}
fn absorb(mut hi:u64,mut lo:u64,hhi:u64,hlo:u64,bytes:&[u8])->(u64,u64){
    let mut at=0usize;
    while at<bytes.len(){
        let n=(bytes.len()-at).min(16usize);let mut padded=[0u8;16];padded[..n].copy_from_slice(&bytes[at..at+n]);
        let next=gf128(hi^be64(&padded,0usize),lo^be64(&padded,8usize),hhi,hlo);hi=next.0;lo=next.1;at+=n;
    }
    (hi,lo)
}
fn tag(keys:&[u8;176],nonce:&[u8],aad:&[u8],ciphertext:&[u8])->[u8;16]{
    let zero=[0u8;16];let h=block(keys,&zero);let hhi=be64(&h,0usize);let hlo=be64(&h,8usize);
    let a=absorb(0u64,0u64,hhi,hlo,aad);let c=absorb(a.0,a.1,hhi,hlo,ciphertext);
    let s=gf128(c.0^((aad.len() as u64)*8u64),c.1^((ciphertext.len() as u64)*8u64),hhi,hlo);
    let mut j=[0u8;16];j[..12].copy_from_slice(nonce);j[15]=1u8;
    let encrypted=block(keys,&j);let mut output=[0u8;16];put64(&mut output,0usize,s.0^be64(&encrypted,0usize));put64(&mut output,8usize,s.1^be64(&encrypted,8usize));output
}
fn crypt(keys:&[u8;176],nonce:&[u8],input:&[u8])->Vec<u8>{
    let mut output=vec![0u8;input.len()];let mut counter=2u32;let mut at=0usize;
    while at<input.len(){
        let mut j=[0u8;16];j[..12].copy_from_slice(nonce);
        j[12]=(counter>>24usize) as u8;j[13]=(counter>>16usize) as u8;j[14]=(counter>>8usize) as u8;j[15]=counter as u8;
        let mask=block(keys,&j);let n=(input.len()-at).min(16usize);let mut i=0usize;
        while i<n{output[at+i]=input[at+i]^mask[i];i+=1usize;}at+=n;counter=counter.wrapping_add(1u32);
    }
    output
}
fn lengths(key:&[u8],nonce:&[u8],aad:&[u8],length:usize)->Result<(),String>{
    if key.len()!=16usize || nonce.len()!=12usize{return Err("AES-128-GCM requires a 16-byte key and 12-byte nonce".to_string());}
    if length>68719476704usize || aad.len()>2305843009213693951usize{return Err("AES-GCM input exceeds its protocol length limit".to_string());}
    Ok(())
}
pub fn seal(key:&[u8],nonce:&[u8],aad:&[u8],plaintext:&[u8])->Result<Vec<u8>,String>{
    lengths(key,nonce,aad,plaintext.len())?;let keys=schedule(key);let mut ciphertext=crypt(&keys,nonce,plaintext);
    let authentication=tag(&keys,nonce,aad,&ciphertext);ciphertext.extend_from_slice(&authentication);Ok(ciphertext)
}
pub fn open(key:&[u8],nonce:&[u8],aad:&[u8],sealed:&[u8])->Result<Vec<u8>,String>{
    if sealed.len()<16usize{return Err("The encrypted record has no complete authentication tag".to_string());}
    let length=sealed.len()-16usize;lengths(key,nonce,aad,length)?;let keys=schedule(key);
    let expected=tag(&keys,nonce,aad,&sealed[..length]);
    if !std::hmac::constant_time_eq(&expected,&sealed[length..]){return Err("The encrypted record failed authentication".to_string());}
    Ok(crypt(&keys,nonce,&sealed[..length]))
}
