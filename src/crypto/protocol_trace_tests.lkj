//! Semantic protocol tests against RFC 8448 section 3 plus bounded malformed records.
//! The public RFC 1024-bit key is used only by the primitive signature verifier.
//! No X.509 or live certificate acceptance policy is weakened for this trace.
mod hkdf;mod aesgcm;mod handshake;mod record;mod der;mod bigint;mod sha512;mod signature;
fn hex(s:&str)->Vec<u8>{let mut v=Vec::new();let b=s.as_bytes();let mut i=0usize;while i<b.len(){let a=if b[i]<=b'9'{b[i]-b'0'}else{b[i]-b'a'+10u8};let c=if b[i+1usize]<=b'9'{b[i+1usize]-b'0'}else{b[i+1usize]-b'a'+10u8};v.push(a*16u8+c);i+=2usize;}v}
fn trace_client_hello()->Vec<u8>{hex("")}
fn trace_server_hello()->Vec<u8>{hex("020000560303a6af06a4121860dc5e6e60249cd34c95930c8ac5cb1434dac155772ed3e2692800130100002e00330024001d0020c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f002b00020304")}
fn trace_encrypted_extensions()->Vec<u8>{hex("080000240022000a00140012001d00170018001901000101010201030104001c0002400100000000")}
fn trace_certificate()->Vec<u8>{hex("")}
fn trace_certificate_verify()->Vec<u8>{hex("0f000084080400805a747c5d88fa9bd2e55ab085a61015b7211f824cd484145ab3ff52f1fda8477b0b7abc90db78e2d33a5c141a078653fa6bef780c5ea248eeaaa785c4f394cab6d30bbe8d4859ee511f602957b15411ac027671459e46445c9ea58c181e818e95b8c3fb0bf3278409d3be152a3da5043e063dda65cdf5aea20d53dfacd42f74f3")}
fn trace_finished()->Vec<u8>{hex("140000209b9b141d906337fbd2cbdce71df4deda4ab42c309572cb7fffee5454b78f0718")}
fn trace_server_flight()->Vec<u8>{hex("")}
fn trace_server_record()->Vec<u8>{hex("")}
fn trace_client_finished()->Vec<u8>{hex("14000020a8ec436d677634ae525ac1fcebe11a039ec17694fac6e98527b642f2edd5ce61")}
fn trace_client_record()->Vec<u8>{hex("170303003575ec4dc238cce60b298044a71e219c56cc77b0517fe9b93c7a4bfc44d87f38f80338ac98fc46deb384bd1caeacab6867d726c40546")}

fn transcript_before_verify()->Vec<u8>{
    let mut t=trace_client_hello();t.extend_from_slice(&trace_server_hello());
    t.extend_from_slice(&trace_encrypted_extensions());t.extend_from_slice(&trace_certificate());t
}
fn transcript_before_finished()->Vec<u8>{let mut t=transcript_before_verify();t.extend_from_slice(&trace_certificate_verify());t}
fn trace_rsa_public()->(Vec<u8>,Vec<u8>){
    let chain=handshake::certificates(&trace_certificate()).unwrap();let bytes=&chain[0usize];
    let outer=der::single(bytes,48u8).unwrap();let mut p=outer.body;
    let tbs=der::expect(bytes,&mut p,outer.end,48u8).unwrap();p=tbs.body;
    der::read(bytes,&mut p,tbs.end).unwrap();der::read(bytes,&mut p,tbs.end).unwrap();
    der::read(bytes,&mut p,tbs.end).unwrap();der::read(bytes,&mut p,tbs.end).unwrap();
    der::read(bytes,&mut p,tbs.end).unwrap();der::read(bytes,&mut p,tbs.end).unwrap();
    let spki=der::expect(bytes,&mut p,tbs.end,48u8).unwrap();p=spki.body;
    der::expect(bytes,&mut p,spki.end,48u8).unwrap();
    let bits=der::expect(bytes,&mut p,spki.end,3u8).unwrap();let key=der::bits(bytes,bits).unwrap();
    let sequence=der::single(&key,48u8).unwrap();p=sequence.body;
    let n=der::expect(&key,&mut p,sequence.end,2u8).unwrap();let e=der::expect(&key,&mut p,sequence.end,2u8).unwrap();
    (der::unsigned(&key,n).unwrap(),der::unsigned(&key,e).unwrap())
}
fn replace_extensions(server:&[u8],extensions:&[u8])->Vec<u8>{
    let original=handshake::body(server,2u8).unwrap();let mut body=original[..38usize].to_vec();
    handshake::put16(&mut body,extensions.len());body.extend_from_slice(extensions);handshake::message(2u8,&body).unwrap()
}
fn retry(cookie:&[u8])->Vec<u8>{
    let original=handshake::body(&trace_server_hello(),2u8).unwrap();let mut prefix=original[..38usize].to_vec();
    let magic=hex("cf21ad74e59a6111be1d8c021e65b891c2a211167abb8c5e079e09e2c8a8339c");
    prefix[2usize..34usize].copy_from_slice(&magic);
    let mut ext=vec![0u8,43u8,0u8,2u8,3u8,4u8,0u8,44u8];
    handshake::put16(&mut ext,cookie.len()+2usize);handshake::put16(&mut ext,cookie.len());ext.extend_from_slice(cookie);
    handshake::put16(&mut prefix,ext.len());prefix.extend_from_slice(&ext);handshake::message(2u8,&prefix).unwrap()
}
#[test]
fn trace_server_hello_and_profile(){
    let parsed=handshake::server_hello(&trace_server_hello(),&[0u8;0]).unwrap();
    assert!(!parsed.retry);assert!(parsed.cookie.is_empty());
    assert_eq!(parsed.share,hex("c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f"));
    // RFC CH offered record_size_limit; this implementation deliberately does not.
    // Its unsolicited reply is refused rather than silently weakening negotiation.
    assert!(handshake::encrypted_extensions(&trace_encrypted_extensions(),true).is_err());
    let supported=handshake::message(8u8,&[0u8,4u8,0u8,0u8,0u8,0u8]).unwrap();
    assert!(handshake::encrypted_extensions(&supported,true).is_ok());
    assert!(handshake::encrypted_extensions(&supported,false).is_err());
}
#[test]
fn trace_flight_every_fragment_boundary(){
    let flight=trace_server_flight();
    let expected=vec![trace_encrypted_extensions(),trace_certificate(),trace_certificate_verify(),trace_finished()];
    let mut cut=0usize;
    while cut<=flight.len(){
        let mut messages=handshake::Messages::new();let mut count=0usize;
        messages.feed(&flight[..cut]).unwrap();
        loop{match messages.next().unwrap(){Some(m)=>{assert!(count<4usize);assert_eq!(m,expected[count]);count+=1usize;},None=>break}}
        messages.feed(&flight[cut..]).unwrap();
        loop{match messages.next().unwrap(){Some(m)=>{assert!(count<4usize);assert_eq!(m,expected[count]);count+=1usize;},None=>break}}
        assert_eq!(count,4usize);assert!(messages.is_empty());cut+=1usize;
    }
    let mut messages=handshake::Messages::new();let mut count=0usize;let mut at=0usize;
    while at<flight.len(){
        messages.feed(&flight[at..at+1usize]).unwrap();at+=1usize;
        if let Some(m)=messages.next().unwrap(){assert_eq!(m,expected[count]);count+=1usize;}
    }
    assert_eq!(count,4usize);assert!(messages.is_empty());
}
#[test]
fn trace_certificate_and_certificate_verify(){
    let chain=handshake::certificates(&trace_certificate()).unwrap();
    assert_eq!(chain.len(),1usize);assert_eq!(chain[0usize].len(),432usize);
    let (scheme,sig)=handshake::certificate_verify(&trace_certificate_verify()).unwrap();
    assert_eq!(scheme,0x0804u16);assert_eq!(sig.len(),128usize);
    let signed=handshake::signature_input(&transcript_before_verify());let (n,e)=trace_rsa_public();
    assert_eq!(n.len(),128usize);
    signature::verify_rsa(&n,&e,&sig,&signed,256u16,true).unwrap();
    let mut wrong_context=signed.clone();wrong_context[64usize]^=1u8;
    assert!(signature::verify_rsa(&n,&e,&sig,&wrong_context,256u16,true).is_err());
    let mut wrong_transcript=transcript_before_verify();wrong_transcript[10usize]^=1u8;
    assert!(signature::verify_rsa(&n,&e,&sig,&handshake::signature_input(&wrong_transcript),256u16,true).is_err());
}
#[test]
fn trace_schedule_finished_and_records(){
let mut hello=trace_client_hello();hello.extend_from_slice(&trace_server_hello());
let keys=handshake::schedule(&hex("8bd4054fb55b9d63fdfbacf9f04b9f0d35e6d63f537563efd46272900f89492d"),&hello).unwrap();
assert_eq!(keys.handshake,hex("1dc826e93606aa6fdc0aadc12f741b01046aa6b99f691ed221a9f0ca043fbeac"));assert_eq!(keys.client,hex("b3eddb126e067f35a780b3abf45e2d8f3b1a950738f52e9600746a0e27a55a21"));assert_eq!(keys.server,hex("b67b7d690cc16c4e75e54213cb2d37b4e9c912bcded9105d42befd59d391ad38"));assert_eq!(keys.master,hex("18df06843d13a08bf2a449844c5f8a478001bc4d4c627984d5a41da8d0402919"));
let before=transcript_before_finished();handshake::verify_finished(&trace_finished(),&keys.server,&before).unwrap();
let mut damaged=trace_finished();damaged[10usize]^=1u8;assert!(handshake::verify_finished(&damaged,&keys.server,&before).is_err());
assert!(handshake::verify_finished(&trace_finished(),&keys.client,&before).is_err());
assert!(handshake::verify_finished(&trace_finished(),&keys.server,&before[..before.len()-1usize]).is_err());
let mut after=before;after.extend_from_slice(&trace_finished());assert_eq!(handshake::finished(&keys.client,&after).unwrap(),trace_client_finished());
let server_wire=trace_server_record();let mut read=record::Traffic::new(keys.server.clone()).unwrap();
let (kind,plaintext)=read.open(&server_wire[..5usize],&server_wire[5usize..]).unwrap();
assert_eq!(kind,22u8);assert_eq!(plaintext,trace_server_flight());
let mut write=record::Traffic::new(keys.client.clone()).unwrap();assert_eq!(write.seal(22u8,&trace_client_finished()).unwrap(),trace_client_record());
assert_eq!(handshake::derive(&keys.master,"s ap traffic",&after).unwrap(),hex("a11af9f05531f856ad47116b45a950328204b4f44bfb6b3a4b4f1f3fcb631643"));assert_eq!(handshake::derive(&keys.master,"c ap traffic",&after).unwrap(),hex("9e40646ce79a7f9dc05af8889bce6552875afa0b06df0087f792ebb7c17504a5"));
}

#[test]
fn cookie_only_retry_and_transcript(){
    let cookie=[91u8,0u8,27u8,255u8];let hrr=retry(&cookie);
    let parsed=handshake::server_hello(&hrr,&[0u8;0]).unwrap();assert!(parsed.retry);
    assert_eq!(parsed.cookie,cookie[..].to_vec());assert!(parsed.share.is_empty());
    let ch=trace_client_hello();let hash=std::sha256::digest(&ch);
    let mut expected=vec![254u8,0u8,0u8,32u8];expected.extend_from_slice(&hash);expected.extend_from_slice(&hrr);
    assert_eq!(handshake::retry_transcript(&ch,&hrr).unwrap(),expected);
    let random=&ch[6usize..38usize];let public=hex("99381de560e4bd43d23d8e435a7dbafeb3c06e51c13cae4d5413691e529aaf2c");
    let second=handshake::client_hello("server",random,&[0u8;0],&public,&cookie).unwrap();
    let data=handshake::body(&second,1u8).unwrap();let mut p=34usize;
    let session=handshake::byte(&data,&mut p).unwrap() as usize;handshake::take(&data,&mut p,session).unwrap();
    let suites=handshake::word(&data,&mut p).unwrap();handshake::take(&data,&mut p,suites).unwrap();
    let compressions=handshake::byte(&data,&mut p).unwrap() as usize;handshake::take(&data,&mut p,compressions).unwrap();
    let extensions=handshake::extensions(&data,&mut p).unwrap();handshake::end(&data,p).unwrap();
    let mut found=false;for e in extensions{if e.kind==44usize{assert_eq!(e.data,vec![0u8,4u8,91u8,0u8,27u8,255u8]);found=true;}}
    assert!(found);assert!(handshake::server_hello(&retry(&[0u8;0]),&[0u8;0]).is_err());
}
#[test]
fn server_negotiation_refusals(){
    let sh=trace_server_hello();let original=handshake::body(&sh,2u8).unwrap();
    assert!(handshake::server_hello(&sh,&[1u8]).is_err());
    let mut wrong=original.clone();wrong[1usize]=2u8;
    assert!(handshake::server_hello(&handshake::message(2u8,&wrong).unwrap(),&[0u8;0]).is_err());
    wrong=original.clone();wrong[36usize]=2u8;
    assert!(handshake::server_hello(&handshake::message(2u8,&wrong).unwrap(),&[0u8;0]).is_err());
    wrong=original.clone();wrong[37usize]=1u8;
    assert!(handshake::server_hello(&handshake::message(2u8,&wrong).unwrap(),&[0u8;0]).is_err());
    let mut extensions=original[40usize..].to_vec();extensions.extend_from_slice(&[0u8,43u8,0u8,2u8,3u8,4u8]);
    assert!(handshake::server_hello(&replace_extensions(&sh,&extensions),&[0u8;0]).is_err());
    extensions=original[40usize..].to_vec();extensions.extend_from_slice(&[0u8,0u8,0u8,0u8]);
    assert!(handshake::server_hello(&replace_extensions(&sh,&extensions),&[0u8;0]).is_err());
    extensions=original[40usize..].to_vec();let last=extensions.len()-1usize;extensions[last]=3u8;
    assert!(handshake::server_hello(&replace_extensions(&sh,&extensions),&[0u8;0]).is_err());
    extensions=original[40usize..].to_vec();extensions[5usize]=23u8;
    assert!(handshake::server_hello(&replace_extensions(&sh,&extensions),&[0u8;0]).is_err());
    assert!(handshake::server_hello(&replace_extensions(&sh,&[0u8,43u8,0u8,2u8,3u8,4u8]),&[0u8;0]).is_err());
    let retry_with_share=replace_extensions(&retry(&[7u8]),&original[40usize..]);
    assert!(handshake::server_hello(&retry_with_share,&[0u8;0]).is_err());
}
#[test]
fn certificate_and_verify_truncations(){
    let cert=trace_certificate();let mut i=0usize;
    while i<cert.len(){assert!(handshake::certificates(&cert[..i]).is_err());i+=1usize;}
    let cv=trace_certificate_verify();i=0usize;
    while i<cv.len(){assert!(handshake::certificate_verify(&cv[..i]).is_err());i+=1usize;}
    let mut wrong=handshake::body(&cert,11u8).unwrap();wrong[0usize]=1u8;
    assert!(handshake::certificates(&handshake::message(11u8,&wrong).unwrap()).is_err());
    assert!(handshake::certificates(&handshake::message(11u8,&[0u8,0u8,0u8,0u8]).unwrap()).is_err());
    let mut wrong_cv=handshake::body(&cv,15u8).unwrap();wrong_cv[0usize]=4u8;wrong_cv[1usize]=1u8;
    assert!(handshake::certificate_verify(&handshake::message(15u8,&wrong_cv).unwrap()).is_err());
}
fn raw_protected(secret:&[u8],plain:&[u8])->Vec<u8>{
    let key=hkdf::label(secret,"key",&[0u8;0],16usize).unwrap();
    let iv=hkdf::label(secret,"iv",&[0u8;0],12usize).unwrap();let length=plain.len()+16usize;
    let mut header=vec![23u8,3u8,3u8,(length>>8usize) as u8,length as u8];
    let sealed=aesgcm::seal(&key,&iv,&header,plain).unwrap();header.extend_from_slice(&sealed);header
}
#[test]
fn authenticated_inner_plaintext_length_before_padding(){
    let secret=vec![17u8;32usize];let mut full=vec![42u8;16384usize];full.push(23u8);
    let wire=raw_protected(&secret,&full);let mut reader=record::Traffic::new(secret.clone()).unwrap();
    let (kind,bytes)=reader.open(&wire[..5usize],&wire[5usize..]).unwrap();assert_eq!(kind,23u8);assert_eq!(bytes.len(),16384usize);
    full.push(0u8);let oversized=raw_protected(&secret,&full);let mut reader=record::Traffic::new(secret.clone()).unwrap();
    assert!(reader.open(&oversized[..5usize],&oversized[5usize..]).is_err());
    let mut padded=vec![0u8;16385usize];padded[0usize]=42u8;padded[1usize]=23u8;
    let wire=raw_protected(&secret,&padded);let mut reader=record::Traffic::new(secret.clone()).unwrap();
    let (kind,bytes)=reader.open(&wire[..5usize],&wire[5usize..]).unwrap();assert_eq!(kind,23u8);assert_eq!(bytes,vec![42u8]);
}
pub fn main(){}
