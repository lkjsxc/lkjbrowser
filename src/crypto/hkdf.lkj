//! HMAC-SHA256 HKDF (RFC 5869) and TLS 1.3 HKDF-Expand-Label.
//! This module has no networking, browser or authority dependency.
pub fn extract(salt:&[u8],ikm:&[u8])->Vec<u8>{
    let digest=std::hmac::sha256(salt,ikm);
    digest[..].to_vec()
}
pub fn expand(prk:&[u8],info:&[u8],length:usize)->Result<Vec<u8>,String>{
    if prk.len()<32usize{return Err("HKDF requires a SHA-256 pseudorandom key of at least 32 bytes".to_string());}
    if length>8160usize{return Err("HKDF output exceeds 255 SHA-256 blocks".to_string());}
    let mut output=Vec::new();
    let mut previous=Vec::new();
    let mut counter=1usize;
    while output.len()<length{
        let mut input=previous.clone();
        input.extend_from_slice(info);input.push(counter as u8);
        let digest=std::hmac::sha256(prk,&input);
        previous=digest[..].to_vec();
        let take=(length-output.len()).min(32usize);
        output.extend_from_slice(&digest[..take]);
        counter+=1usize;
    }
    Ok(output)
}
pub fn label(secret:&[u8],label:&str,context:&[u8],length:usize)->Result<Vec<u8>,String>{
    if label.len()>249usize || label.is_empty() || context.len()>255usize || length>65535usize {
        return Err("TLS HKDF label or output length is invalid".to_string());
    }
    let mut info=vec![(length>>8usize) as u8,length as u8,(label.len()+6usize) as u8];
    info.extend_from_slice(b"tls13 ");info.extend_from_slice(label.as_bytes());
    info.push(context.len() as u8);info.extend_from_slice(context);
    expand(secret,&info,length)
}
