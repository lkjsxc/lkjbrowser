//! Test-only public known answers; provenance: tests/signature/vectors.json.
use super::signature::{verify_rsa,verify_ecdsa,hash_message};
fn hx(s:&str)->Vec<u8>{let mut out=Vec::new();let b=s.as_bytes();let mut i=0usize;while i<b.len(){let a=if b[i]<=b'9'{b[i]-b'0'}else{b[i].to_ascii_lowercase()-b'a'+10u8};let c=if b[i+1usize]<=b'9'{b[i+1usize]-b'0'}else{b[i+1usize].to_ascii_lowercase()-b'a'+10u8};out.push(a*16u8+c);i+=2usize;}out}
#[test]
fn rsa_2048_256_v15(){
let n=hx("");let e=hx("010001");let s=hx("");let m=hx("6c6b6a62726f77736572207075626c6963207369676e617475726520766572696669636174696f6e20666978747572652076310a");
assert!(verify_rsa(&n,&e,&s,&m,256u16,false).is_ok());
assert!(verify_rsa(&n,&e,&s,b"changed",256u16,false).is_err());
let mut bad=s.clone();bad[10usize]^=1u8;assert!(verify_rsa(&n,&e,&bad,&m,256u16,false).is_err());
assert!(verify_rsa(&n,&e,&n,&m,256u16,false).is_err());}
#[test]
