#[test]
fn montgomery_128_true(){
let m=Modulus::new(&hx("01ad98a85222a1f5413177ff35a678d953fa429ef27d6be9b465b4380d3b603897162a1cc704b42e9c741046852021aeb9c46deb64c729657ace69ea82e2fe9c819b60d150c2f4f36389697f77d55e32413575fcbd5219f8365cb313aea7db45328ce1b8b6e328b5b4c51fd603440b7c2046cd6c7defe2e2ff0bae4014670ee5")).unwrap();let a=from_be(&hx("00a3161d46087de7b526e6814575c5326dcd5a387353d0412152b164494b272caa1dae8a90a3486a7153b5e24ac69afa6f8021d6739062687e5eadb6838c5ce76828bbd718ff0031763a45ba4c1d8c5ee0f4093ed02a99357d5c8014741ea3da87b230a80eb12751f4deda56991aaa1f09dfc469db4f4ee26c854cd3c3950e54"),32usize).unwrap();let b=from_be(&hx("004bc2cd8c12f64f1a9d2d439b423d9599b09f69d01795d302e2be00b1c6d4a7ee5da8612a3b2ec92d6981930fb6fbcdd66e28f0f4024ef9e76edeefaefb59836d4ab7e79040771eb4d1e1c4ba5263b2560d8339474d5e0e13df9aabf62faa207a2f6bc35a5c51bfa98e4f09da1a3e0441b567559094c191f43a22e7463bf92e"),32usize).unwrap();
assert_eq!(to_be(&m.decode(&m.mul(&m.encode(&a),&m.encode(&b))),128usize),hx("01322bdddaa13507b7e1b7222ffa847852512e6d5494ff930503500f496f8f8fa9541b27dafd680f54e8abf0d3fe3bb045c4cd4bc51fa561b22e9f0d12f5309c25efe96b363c6c0f9d780295c97e6817df7d951842066b745b880863cfe9bd3de81f45c99eec9d735eed9fce75642572774b6d6c0a6b975ec47b389b2651ca7a"));
let e=from_be(&hx("010001"),1usize).unwrap();assert_eq!(to_be(&m.decode(&m.pow(&m.encode(&a),&e)),128usize),hx("0003be6f5d1f70c5872c23a2aa613753d210100d6e358a289e7fae95f633d84523fd17e000f54c10817e9099869322a8b9e720192dceded26f76fe4b60efc7c44f782018353ff7c378a3422aa4b046a8e369e9946664728984e4016bcd5bc904b675888b570f70291d33b3a1242c034c098103114993e66a2af1f4be2f8d7b53"));}
#[test]
fn montgomery_256_false(){
let m=Modulus::new(&hx("")).unwrap();let a=from_be(&hx(""),64usize).unwrap();let b=from_be(&hx(""),64usize).unwrap();
assert_eq!(to_be(&m.decode(&m.mul(&m.encode(&a),&m.encode(&b))),256usize),hx(""));
let e=from_be(&hx("010001"),1usize).unwrap();assert_eq!(to_be(&m.decode(&m.pow(&m.encode(&a),&e)),256usize),hx(""));}
#[test]
fn montgomery_256_true(){
let m=Modulus::new(&hx("")).unwrap();let a=from_be(&hx(""),64usize).unwrap();let b=from_be(&hx(""),64usize).unwrap();
assert_eq!(to_be(&m.decode(&m.mul(&m.encode(&a),&m.encode(&b))),256usize),hx(""));
let e=from_be(&hx("010001"),1usize).unwrap();assert_eq!(to_be(&m.decode(&m.pow(&m.encode(&a),&e)),256usize),hx(""));}
#[test]
fn montgomery_384_false(){
