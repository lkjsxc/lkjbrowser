fn montgomery_32_false(){
let m=Modulus::new(&hx("cbaddd15f61a3536c69230941a31bb8f935dcc21ee49e5b9a33452cd6b1cbc63")).unwrap();let a=from_be(&hx("1076da80f1d37ab307d6773e48dd12132923ddb5b55877189fb82e471c601aae"),8usize).unwrap();let b=from_be(&hx("53502be659100d901994b6c333096fcdb84d4f5d089870404cfbffe8163182d6"),8usize).unwrap();
assert_eq!(to_be(&m.decode(&m.mul(&m.encode(&a),&m.encode(&b))),32usize),hx("ad8447514a03eb686010b6aea987367e83e20cad5d31f43a027a024d9e9e6a2f"));
let e=from_be(&hx("010001"),1usize).unwrap();assert_eq!(to_be(&m.decode(&m.pow(&m.encode(&a),&e)),32usize),hx("5bc91fb6e1810c0c0eafb18b06519a74b6af1530749540dfcee0187e345e1624"));}
#[test]
fn montgomery_32_true(){
let m=Modulus::new(&hx("012e12ca21d0e0d36e50db2a4c3057b649f2fdd4e15dfbc2b4df9790a686d7b3")).unwrap();let a=from_be(&hx("0080cd2fe292a14ed624f058de87804e04b5dca9aa9ce6a56aa2a6ad268b5c02"),8usize).unwrap();let b=from_be(&hx("011266ee21872e46641dd07ff8259ad4e96c3bc40a7531dda50e7e1550bffdcb"),8usize).unwrap();
assert_eq!(to_be(&m.decode(&m.mul(&m.encode(&a),&m.encode(&b))),32usize),hx("0086fcd488012d073c21cd0fab583df0904c5107e747b5fd6ddbb3f0bb231a45"));
let e=from_be(&hx("010001"),1usize).unwrap();assert_eq!(to_be(&m.decode(&m.pow(&m.encode(&a),&e)),32usize),hx("007b9112e6c10e1811cf93810069c2d6e7765f97ff6733bf42be24343a6ec6af"));}
