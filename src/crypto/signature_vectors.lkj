let e=from_be(&hx("010001"),1usize).unwrap();assert_eq!(to_be(&m.decode(&m.pow(&m.encode(&a),&e)),384usize),hx(""));}
#[test]
fn montgomery_384_true(){
let m=Modulus::new(&hx("")).unwrap();let a=from_be(&hx(""),96usize).unwrap();let b=from_be(&hx(""),96usize).unwrap();
assert_eq!(to_be(&m.decode(&m.mul(&m.encode(&a),&m.encode(&b))),384usize),hx(""));
let e=from_be(&hx("010001"),1usize).unwrap();assert_eq!(to_be(&m.decode(&m.pow(&m.encode(&a),&e)),384usize),hx(""));}
#[test]
fn montgomery_512_false(){
let m=Modulus::new(&hx("")).unwrap();let a=from_be(&hx(""),128usize).unwrap();let b=from_be(&hx(""),128usize).unwrap();
assert_eq!(to_be(&m.decode(&m.mul(&m.encode(&a),&m.encode(&b))),512usize),hx(""));
let e=from_be(&hx("010001"),1usize).unwrap();assert_eq!(to_be(&m.decode(&m.pow(&m.encode(&a),&e)),512usize),hx(""));}
#[test]
fn montgomery_512_true(){
let m=Modulus::new(&hx("")).unwrap();let a=from_be(&hx(""),128usize).unwrap();let b=from_be(&hx(""),128usize).unwrap();
assert_eq!(to_be(&m.decode(&m.mul(&m.encode(&a),&m.encode(&b))),512usize),hx(""));
let e=from_be(&hx("010001"),1usize).unwrap();assert_eq!(to_be(&m.decode(&m.pow(&m.encode(&a),&e)),512usize),hx(""));}

#[test]
fn rfc9474_a1_pss_sha384(){
let n=hx("");let e=hx("010001");let m=hx("8417e699b219d583fb6216ae0c53ca0e9723442d02f1d1a34295527e7d929e8b8f3dc6fb8c4a02f4d6352edf0907822c1210a9b32f9bdda4c45a698c80023aa6b59f8cfec5fdbb36331372ebefedae7d");let s=hx("");assert!(verify_rsa(&n,&e,&s,&m,384u16,true).is_ok());assert!(verify_rsa(&n,&e,&s,b"wrong",384u16,true).is_err());}
