#[test]
fn hash_256_111(){let mut b=Vec::new();let mut i=0usize;while i<111usize{b.push(i as u8);i+=1usize;}assert_eq!(hash_message(&b,256u16).unwrap(),hx("60780e9451bdc43cf4530ffc95cbb0c4eb24dae2c39f55f334d679e076c08065"));}
#[test]
fn hash_384_111(){let mut b=Vec::new();let mut i=0usize;while i<111usize{b.push(i as u8);i+=1usize;}assert_eq!(hash_message(&b,384u16).unwrap(),hx("f5f9fe110d809d34029de262a01b208356caec6e054c7f926b2591f6c9780579d4b59f5578c6f531a84f158a33660cef"));}
