use super::bigint::{Modulus,from_be,to_be};
#[test]
fn montgomery_1_false(){
let m=Modulus::new(&hx("c7")).unwrap();let a=from_be(&hx("a6"),1usize).unwrap();let b=from_be(&hx("1f"),1usize).unwrap();
assert_eq!(to_be(&m.decode(&m.mul(&m.encode(&a),&m.encode(&b))),1usize),hx("ab"));
let e=from_be(&hx("010001"),1usize).unwrap();assert_eq!(to_be(&m.decode(&m.pow(&m.encode(&a),&e)),1usize),hx("06"));}
#[test]
fn montgomery_2_false(){
let m=Modulus::new(&hx("eb31")).unwrap();let a=from_be(&hx("ae6b"),1usize).unwrap();let b=from_be(&hx("1284"),1usize).unwrap();
assert_eq!(to_be(&m.decode(&m.mul(&m.encode(&a),&m.encode(&b))),2usize),hx("2b61"));
let e=from_be(&hx("010001"),1usize).unwrap();assert_eq!(to_be(&m.decode(&m.pow(&m.encode(&a),&e)),2usize),hx("6264"));}
#[test]
fn montgomery_2_true(){
let m=Modulus::new(&hx("0157")).unwrap();let a=from_be(&hx("00c0"),1usize).unwrap();let b=from_be(&hx("00bc"),1usize).unwrap();
assert_eq!(to_be(&m.decode(&m.mul(&m.encode(&a),&m.encode(&b))),2usize),hx("0051"));
let e=from_be(&hx("010001"),1usize).unwrap();assert_eq!(to_be(&m.decode(&m.pow(&m.encode(&a),&e)),2usize),hx("011d"));}
#[test]
fn montgomery_4_false(){
let m=Modulus::new(&hx("c0b1d385")).unwrap();let a=from_be(&hx("53889b8a"),1usize).unwrap();let b=from_be(&hx("b1a7f3dd"),1usize).unwrap();
assert_eq!(to_be(&m.decode(&m.mul(&m.encode(&a),&m.encode(&b))),4usize),hx("7a8c489f"));
let e=from_be(&hx("010001"),1usize).unwrap();assert_eq!(to_be(&m.decode(&m.pow(&m.encode(&a),&e)),4usize),hx("08001393"));}
#[test]
fn montgomery_4_true(){
let m=Modulus::new(&hx("018fa7c5")).unwrap();let a=from_be(&hx("00ef7fdc"),1usize).unwrap();let b=from_be(&hx("007d2e1c"),1usize).unwrap();
assert_eq!(to_be(&m.decode(&m.mul(&m.encode(&a),&m.encode(&b))),4usize),hx("008b1684"));
let e=from_be(&hx("010001"),1usize).unwrap();assert_eq!(to_be(&m.decode(&m.pow(&m.encode(&a),&e)),4usize),hx("017605a2"));}
#[test]
fn montgomery_7_false(){
let m=Modulus::new(&hx("bd9c59ca427e7f")).unwrap();let a=from_be(&hx("4047c60ac717f6"),2usize).unwrap();let b=from_be(&hx("9bac4dcd64ebf7"),2usize).unwrap();
assert_eq!(to_be(&m.decode(&m.mul(&m.encode(&a),&m.encode(&b))),7usize),hx("7a55d4e63be5cc"));
let e=from_be(&hx("010001"),1usize).unwrap();assert_eq!(to_be(&m.decode(&m.pow(&m.encode(&a),&e)),7usize),hx("0b7bdd69dcd1e8"));}
#[test]
fn montgomery_7_true(){
let m=Modulus::new(&hx("01d603ef4c62bb")).unwrap();let a=from_be(&hx("0138734f1fa1c8"),2usize).unwrap();let b=from_be(&hx("01942b7871ba0e"),2usize).unwrap();
assert_eq!(to_be(&m.decode(&m.mul(&m.encode(&a),&m.encode(&b))),7usize),hx("00f0da558d1b8a"));
let e=from_be(&hx("010001"),1usize).unwrap();assert_eq!(to_be(&m.decode(&m.pow(&m.encode(&a),&e)),7usize),hx("0132d76a18d18c"));}
#[test]
fn montgomery_16_false(){
let m=Modulus::new(&hx("941c8b9d24aec21025848a20fe559739")).unwrap();let a=from_be(&hx("359894ad8ff5395c98df36de2ff10036"),4usize).unwrap();let b=from_be(&hx("26048d3a4b44b9af7dc4100657203c74"),4usize).unwrap();
assert_eq!(to_be(&m.decode(&m.mul(&m.encode(&a),&m.encode(&b))),16usize),hx("7e67db288459b6ea62bc231371119a23"));
let e=from_be(&hx("010001"),1usize).unwrap();assert_eq!(to_be(&m.decode(&m.pow(&m.encode(&a),&e)),16usize),hx("2cf47203c3f23c858e43974002fc0d91"));}
#[test]
fn montgomery_16_true(){
let m=Modulus::new(&hx("0113a06651e9a97023211754492e0199")).unwrap();let a=from_be(&hx("010c5bd30e6f48d7aaca776ff30baee4"),4usize).unwrap();let b=from_be(&hx("00bcc08feab934eb602c7aa4d49f4c40"),4usize).unwrap();
assert_eq!(to_be(&m.decode(&m.mul(&m.encode(&a),&m.encode(&b))),16usize),hx("00525729420be1fad11dcd75cd438b6b"));
let e=from_be(&hx("010001"),1usize).unwrap();assert_eq!(to_be(&m.decode(&m.pow(&m.encode(&a),&e)),16usize),hx("006254d801241d80f63193fac5b9b828"));}
