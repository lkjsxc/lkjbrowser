assert!(verify_rsa(&n,&e,&s,&m,256u16,true).is_ok());
assert!(verify_rsa(&n,&e,&s,b"changed",256u16,true).is_err());
let mut bad=s.clone();bad[10usize]^=1u8;assert!(verify_rsa(&n,&e,&bad,&m,256u16,true).is_err());
assert!(verify_rsa(&n,&e,&n,&m,256u16,true).is_err());}
