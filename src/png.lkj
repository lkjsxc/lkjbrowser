//! PNG and zlib/DEFLATE decoded in lkjscript. No native codec dependency.
//! PNG: https://www.w3.org/TR/png/ ; DEFLATE: RFC 1951; zlib: RFC 1950.

pub struct Image { pub width: usize, pub height: usize, pub pixels: Vec<u32> }

const MAX_FILE: usize = 33554432usize;
const MAX_AXIS: usize = 4096usize;
const MAX_PIXELS: usize = 8388608usize;
const LENGTH_BASE: [usize; 29] = [3usize,4usize,5usize,6usize,7usize,8usize,9usize,10usize,11usize,13usize,15usize,17usize,19usize,23usize,27usize,31usize,35usize,43usize,51usize,59usize,67usize,83usize,99usize,115usize,131usize,163usize,195usize,227usize,258usize];
const LENGTH_EXTRA: [u8; 29] = [0u8,0u8,0u8,0u8,0u8,0u8,0u8,0u8,1u8,1u8,1u8,1u8,2u8,2u8,2u8,2u8,3u8,3u8,3u8,3u8,4u8,4u8,4u8,4u8,5u8,5u8,5u8,5u8,0u8];
const DISTANCE_BASE: [usize; 30] = [1usize,2usize,3usize,4usize,5usize,7usize,9usize,13usize,17usize,25usize,33usize,49usize,65usize,97usize,129usize,193usize,257usize,385usize,513usize,769usize,1025usize,1537usize,2049usize,3073usize,4097usize,6145usize,8193usize,12289usize,16385usize,24577usize];
const DISTANCE_EXTRA: [u8; 30] = [0u8,0u8,0u8,0u8,1u8,1u8,2u8,2u8,3u8,3u8,4u8,4u8,5u8,5u8,6u8,6u8,7u8,7u8,8u8,8u8,9u8,9u8,10u8,10u8,11u8,11u8,12u8,12u8,13u8,13u8];
const CODE_ORDER: [usize; 19] = [16usize,17usize,18usize,0usize,8usize,7usize,9usize,6usize,10usize,5usize,11usize,4usize,12usize,3usize,13usize,2usize,14usize,1usize,15usize];

struct Bits { data: Vec<u8>, at: usize, bit: u8 }
impl Bits {
    fn read(&mut self, count: u8) -> Result<u32,String> {
        let mut result = 0u32;
        let mut shift = 0u8;
        while shift < count {
            if self.at >= self.data.len() { return Err("truncated DEFLATE bitstream".to_string()); }
            result |= (((self.data[self.at] >> self.bit) & 1u8) as u32) << shift;
            self.bit += 1u8;
            if self.bit == 8u8 { self.bit = 0u8; self.at += 1usize; }
            shift += 1u8;
        }
        Ok(result)
    }
    fn align(&mut self) {
        if self.bit != 0u8 { self.bit = 0u8; self.at += 1usize; }
    }
}

struct Huffman { counts: [u16;16], symbols: Vec<u16>, complete: bool }
impl Huffman {
    fn build(lengths: &[u8]) -> Result<Huffman,String> {
        let mut counts = [0u16;16];
        let mut i = 0usize;
        while i < lengths.len() {
            let length = lengths[i] as usize;
            if length > 15usize { return Err("invalid Huffman code length".to_string()); }
            if length > 0usize { counts[length] += 1u16; }
            i += 1usize;
        }
        let mut available = 1i32;
        i = 1usize;
        while i <= 15usize {
            available = available * 2i32 - counts[i] as i32;
            if available < 0i32 { return Err("oversubscribed Huffman tree".to_string()); }
            i += 1usize;
        }
        let mut symbols = Vec::<u16>::new();
        let mut length = 1u8;
        while length <= 15u8 {
            i = 0usize;
            while i < lengths.len() {
                if lengths[i] == length { symbols.push(i as u16); }
                i += 1usize;
            }
            length += 1u8;
        }
        if available > 0i32 && !symbols.is_empty() && !(symbols.len() == 1usize && counts[1usize] == 1u16) {
            return Err("incomplete Huffman tree".to_string());
        }
        Ok(Huffman { counts, symbols, complete: available == 0i32 })
    }
    fn symbol(&self, bits: &mut Bits) -> Result<u16,String> {
        let mut code = 0u32;
        let mut first = 0u32;
        let mut index = 0usize;
        let mut length = 1usize;
        while length <= 15usize {
            code |= bits.read(1u8)?;
            let count = self.counts[length] as u32;
            if code >= first && code < first + count {
                return Ok(self.symbols[index + (code - first) as usize]);
            }
            index += count as usize;
            first = (first + count) << 1;
            code <<= 1;
            length += 1usize;
        }
        Err("invalid Huffman symbol".to_string())
    }
}

fn fixed_trees() -> Result<(Huffman,Huffman),String> {
    let mut literal = vec![8u8;288usize];
    let mut i = 144usize;
    while i < 256usize { literal[i] = 9u8; i += 1usize; }
    while i < 280usize { literal[i] = 7u8; i += 1usize; }
    let distance = [5u8;32];
    Ok((Huffman::build(&literal)?,Huffman::build(&distance)?))
}

fn dynamic_trees(bits: &mut Bits) -> Result<(Huffman,Huffman),String> {
    let literal_count = bits.read(5u8)? as usize + 257usize;
    let distance_count = bits.read(5u8)? as usize + 1usize;
    let code_count = bits.read(4u8)? as usize + 4usize;
    if literal_count > 286usize { return Err("invalid literal code count".to_string()); }
    let mut code_lengths = [0u8;19];
    let mut i = 0usize;
    while i < code_count { code_lengths[CODE_ORDER[i]] = bits.read(3u8)? as u8; i += 1usize; }
    let codes = Huffman::build(&code_lengths)?;
    if !codes.complete { return Err("incomplete code-length Huffman tree".to_string()); }
    let total = literal_count + distance_count;
    let mut lengths = Vec::<u8>::new();
    while lengths.len() < total {
        let value = codes.symbol(bits)?;
        if value < 16u16 { lengths.push(value as u8); }
        else {
            let mut repeat = 0usize;
            let mut length = 0u8;
            if value == 16u16 {
                if lengths.is_empty() { return Err("Huffman repeat has no previous length".to_string()); }
                length = lengths[lengths.len() - 1usize];
                repeat = bits.read(2u8)? as usize + 3usize;
            } else if value == 17u16 { repeat = bits.read(3u8)? as usize + 3usize; }
            else if value == 18u16 { repeat = bits.read(7u8)? as usize + 11usize; }
            else { return Err("invalid code-length symbol".to_string()); }
            if repeat > total - lengths.len() { return Err("Huffman repeat exceeds tree".to_string()); }
            i = 0usize;
            while i < repeat { lengths.push(length); i += 1usize; }
        }
    }
    if lengths[256usize] == 0u8 { return Err("Huffman tree has no end marker".to_string()); }
    Ok((Huffman::build(&lengths[..literal_count])?,Huffman::build(&lengths[literal_count..])?))
}

fn u32be(data: &[u8], at: usize) -> u32 {
    ((data[at] as u32) << 24) | ((data[at + 1usize] as u32) << 16)
        | ((data[at + 2usize] as u32) << 8) | data[at + 3usize] as u32
}
fn u16be(data: &[u8], at: usize) -> u16 {
    ((data[at] as u16) << 8) | data[at + 1usize] as u16
}
fn adler32(data: &[u8]) -> u32 {
    let mut a = 1u32;
    let mut b = 0u32;
    let mut i = 0usize;
    while i < data.len() {
        a = (a + data[i] as u32) % 65521u32;
        b = (b + a) % 65521u32;
        i += 1usize;
    }
    (b << 16) | a
}
fn crc32(data: &[u8]) -> u32 {
    let mut crc = 0xffffffffu32;
    let mut i = 0usize;
    while i < data.len() {
        crc ^= data[i] as u32;
        let mut bit = 0usize;
        while bit < 8usize {
            crc = if crc & 1u32 != 0u32 { (crc >> 1) ^ 0xedb88320u32 } else { crc >> 1 };
            bit += 1usize;
        }
        i += 1usize;
    }
    crc ^ 0xffffffffu32
}

pub fn inflate(data: &[u8], limit: usize) -> Result<Vec<u8>,String> {
    inflate_limited(data,limit,8192usize)
}

fn inflate_limited(data: &[u8], limit: usize, block_limit: usize) -> Result<Vec<u8>,String> {
    if data.len() < 6usize { return Err("truncated zlib stream".to_string()); }
    let cmf = data[0usize];
    let flags = data[1usize];
    if cmf & 15u8 != 8u8 || cmf >> 4 > 7u8 || u16be(data, 0usize) % 31u16 != 0u16 {
        return Err("invalid zlib header".to_string());
    }
    if flags & 32u8 != 0u8 { return Err("zlib preset dictionary is not allowed in PNG".to_string()); }
    let window = 1usize << ((cmf >> 4) + 8u8);
    let expected_adler = u32be(data, data.len() - 4usize);
    let (output, consumed) = deflate_stream(&data[2usize..data.len() - 4usize], limit, block_limit, window)?;
    if consumed != data.len() - 6usize { return Err("trailing bytes in zlib stream".to_string()); }
    if adler32(&output) != expected_adler { return Err("zlib Adler-32 mismatch".to_string()); }
    Ok(output)
}

/// Decode one raw RFC 1951 stream, returning its consumed byte count. A caller
/// such as gzip owns the envelope, checksum, member count and trailing-data policy.
pub fn inflate_raw(data: &[u8], limit: usize) -> Result<(Vec<u8>,usize),String> {
    deflate_stream(data, limit, 8192usize, 32768usize)
}

fn deflate_stream(data: &[u8], limit: usize, block_limit: usize, window: usize) -> Result<(Vec<u8>,usize),String> {
    let mut bits = Bits { data: data.to_vec(), at: 0usize, bit: 0u8 };
    let mut output = Vec::<u8>::new();
    let mut final_block = false;
    let mut blocks = 0usize;
    while !final_block {
        if blocks >= block_limit { return Err("DEFLATE block count exceeds image work policy".to_string()); }
        blocks += 1usize;
        final_block = bits.read(1u8)? != 0u32;
        let kind = bits.read(2u8)?;
        if kind == 0u32 {
            bits.align();
            let length = bits.read(16u8)? as usize;
            let complement = bits.read(16u8)? as usize;
            if length ^ complement != 65535usize { return Err("invalid stored DEFLATE block length".to_string()); }
            if length > limit - output.len() { return Err("PNG decoded data exceeds its dimensions".to_string()); }
            let mut i = 0usize;
            while i < length { output.push(bits.read(8u8)? as u8); i += 1usize; }
        } else if kind == 1u32 || kind == 2u32 {
            let trees = if kind == 1u32 { fixed_trees()? } else { dynamic_trees(&mut bits)? };
            loop {
                let symbol = trees.0.symbol(&mut bits)?;
                if symbol < 256u16 {
                    if output.len() >= limit { return Err("PNG decoded data exceeds its dimensions".to_string()); }
                    output.push(symbol as u8);
                } else if symbol == 256u16 { break; }
                else if symbol <= 285u16 {
                    let code = symbol as usize - 257usize;
                    let length = LENGTH_BASE[code] + bits.read(LENGTH_EXTRA[code])? as usize;
                    let distance_code = trees.1.symbol(&mut bits)? as usize;
                    if distance_code >= 30usize { return Err("reserved DEFLATE distance code".to_string()); }
                    let distance = DISTANCE_BASE[distance_code] + bits.read(DISTANCE_EXTRA[distance_code])? as usize;
                    if distance > output.len() || distance > window { return Err("invalid DEFLATE backward distance".to_string()); }
                    if length > limit - output.len() { return Err("PNG decoded data exceeds its dimensions".to_string()); }
                    let mut i = 0usize;
                    while i < length {
                        let value = output[output.len() - distance];
                        output.push(value);
                        i += 1usize;
                    }
                } else { return Err("reserved DEFLATE length code".to_string()); }
            }
        } else { return Err("reserved DEFLATE block type".to_string()); }
    }
    bits.align();
    Ok((output, bits.at))
}

fn abs_i(v: i32) -> i32 { if v < 0i32 { -v } else { v } }
fn paeth(a: u8, b: u8, c: u8) -> u8 {
    let p = a as i32 + b as i32 - c as i32;
    let pa = abs_i(p - a as i32);
    let pb = abs_i(p - b as i32);
    let pc = abs_i(p - c as i32);
    if pa <= pb && pa <= pc { a } else if pb <= pc { b } else { c }
}

pub fn decode(data: &[u8]) -> Result<Image,String> {
    if data.len() < 8usize || data.len() > MAX_FILE { return Err("PNG file is truncated or exceeds 32 MiB policy".to_string()); }
    let signature = [137u8,80u8,78u8,71u8,13u8,10u8,26u8,10u8];
    let mut i = 0usize;
    while i < 8usize {
        if data[i] != signature[i] { return Err("invalid PNG signature".to_string()); }
        i += 1usize;
    }
    let mut width = 0usize;
    let mut height = 0usize;
    let mut color = 0u8;
    let mut channels = 0usize;
    let mut header_seen = false;
    let mut palette_seen = false;
    let mut transparency_seen = false;
    let mut idat_seen = false;
    let mut idat_closed = false;
    let mut end_seen = false;
    let mut palette = Vec::<u8>::new();
    let mut transparency = Vec::<u8>::new();
    let mut compressed = Vec::<u8>::new();
    let mut at = 8usize;
    while at < data.len() {
        if data.len() - at < 12usize { return Err("truncated PNG chunk".to_string()); }
        let length = u32be(data, at) as usize;
        if length > data.len() - at - 12usize { return Err("PNG chunk extends beyond file".to_string()); }
        let kind = u32be(data, at + 4usize);
        let start = at + 8usize;
        let end = start + length;
        i = at + 4usize;
        while i < at + 8usize {
            let c = data[i];
            if !((c >= 65u8 && c <= 90u8) || (c >= 97u8 && c <= 122u8)) { return Err("invalid PNG chunk type".to_string()); }
            i += 1usize;
        }
        if data[at + 6usize] & 32u8 != 0u8 { return Err("invalid reserved PNG chunk bit".to_string()); }
        if crc32(&data[at + 4usize..end]) != u32be(data, end) { return Err("PNG chunk CRC-32 mismatch".to_string()); }
        if !header_seen && kind != 0x49484452u32 { return Err("PNG must begin with IHDR".to_string()); }
        if idat_seen && kind != 0x49444154u32 { idat_closed = true; }
        if kind == 0x49484452u32 {
            if header_seen || length != 13usize { return Err("invalid or duplicate PNG IHDR".to_string()); }
            width = u32be(data, start) as usize;
            height = u32be(data, start + 4usize) as usize;
            if width == 0usize || height == 0usize || width > MAX_AXIS || height > MAX_AXIS || width * height > MAX_PIXELS {
                return Err("PNG dimensions exceed 4096 axis / 8 Mpixel policy".to_string());
            }
            if data[start + 8usize] != 8u8 { return Err("PNG first slice supports 8-bit samples only".to_string()); }
            color = data[start + 9usize];
            channels = match color { 0u8 => 1usize, 2u8 => 3usize, 3u8 => 1usize, 4u8 => 2usize, 6u8 => 4usize,
                _ => return Err("invalid PNG color type".to_string()) };
            if data[start + 10usize] != 0u8 || data[start + 11usize] != 0u8 { return Err("unsupported PNG compression/filter method".to_string()); }
            if data[start + 12usize] != 0u8 { return Err("interlaced PNG is not implemented in this slice".to_string()); }
            header_seen = true;
        } else if kind == 0x504c5445u32 {
            if palette_seen || idat_seen || length == 0usize || length % 3usize != 0usize || length > 768usize || color == 0u8 || color == 4u8 {
                return Err("invalid PNG palette".to_string());
            }
            palette = data[start..end].to_vec();
            palette_seen = true;
        } else if kind == 0x74524e53u32 {
            if transparency_seen || idat_seen || (color == 0u8 && length != 2usize)
                || (color == 2u8 && length != 6usize)
                || (color == 3u8 && (!palette_seen || length == 0usize || length > palette.len() / 3usize))
                || color == 4u8 || color == 6u8 {
                return Err("invalid PNG transparency chunk".to_string());
            }
            transparency = data[start..end].to_vec();
            transparency_seen = true;
        } else if kind == 0x49444154u32 {
            if idat_closed || (color == 3u8 && !palette_seen) { return Err("invalid PNG IDAT order".to_string()); }
            compressed.extend_from_slice(&data[start..end]);
            idat_seen = true;
        } else if kind == 0x49454e44u32 {
            if length != 0usize || !idat_seen { return Err("invalid PNG IEND".to_string()); }
            end_seen = true;
            at = end + 4usize;
            break;
        } else if data[at + 4usize] & 32u8 == 0u8 { return Err("unknown critical PNG chunk".to_string()); }
        at = end + 4usize;
    }
    if !header_seen || !idat_seen || !end_seen || at != data.len() { return Err("missing PNG terminator or trailing data".to_string()); }
    let row_bytes = width * channels;
    let expected = (row_bytes + 1usize) * height;
    let raw = inflate(&compressed, expected)?;
    if raw.len() != expected { return Err("PNG decoded byte count does not match dimensions".to_string()); }
    let mut decoded = vec![0u8; row_bytes * height];
    let mut row = 0usize;
    while row < height {
        let filter = raw[row * (row_bytes + 1usize)];
        if filter > 4u8 { return Err("invalid PNG row filter".to_string()); }
        let mut col = 0usize;
        while col < row_bytes {
            let index = row * row_bytes + col;
            let a = if col >= channels { decoded[index - channels] } else { 0u8 };
            let b = if row > 0usize { decoded[index - row_bytes] } else { 0u8 };
            let c = if row > 0usize && col >= channels { decoded[index - row_bytes - channels] } else { 0u8 };
            let predictor = match filter { 0u8 => 0u8, 1u8 => a, 2u8 => b,
                3u8 => ((a as u16 + b as u16) / 2u16) as u8, _ => paeth(a,b,c) };
            decoded[index] = raw[row * (row_bytes + 1usize) + 1usize + col].wrapping_add(predictor);
            col += 1usize;
        }
        row += 1usize;
    }
    let mut pixels = Vec::<u32>::new();
    i = 0usize;
    while i < width * height {
        let p = i * channels;
        let mut r = 0u8;
        let mut g = 0u8;
        let mut b = 0u8;
        let mut a = 255u8;
        if color == 0u8 || color == 4u8 {
            r = decoded[p]; g = r; b = r;
            if color == 4u8 { a = decoded[p + 1usize]; }
            else if transparency.len() == 2usize && r as u16 == u16be(&transparency,0usize) { a = 0u8; }
        } else if color == 2u8 || color == 6u8 {
            r = decoded[p]; g = decoded[p + 1usize]; b = decoded[p + 2usize];
            if color == 6u8 { a = decoded[p + 3usize]; }
            else if transparency.len() == 6usize && r as u16 == u16be(&transparency,0usize)
                && g as u16 == u16be(&transparency,2usize) && b as u16 == u16be(&transparency,4usize) { a = 0u8; }
        } else {
            let entry = decoded[p] as usize;
            if entry >= palette.len() / 3usize { return Err("PNG pixel references missing palette entry".to_string()); }
            r = palette[entry * 3usize]; g = palette[entry * 3usize + 1usize]; b = palette[entry * 3usize + 2usize];
            if entry < transparency.len() { a = transparency[entry]; }
        }
        pixels.push(((a as u32) << 24) | ((r as u32) << 16) | ((g as u32) << 8) | b as u32);
        i += 1usize;
    }
    Ok(Image { width, height, pixels })
}

#[test]
fn known_checksums() {
    assert_eq!(crc32(b"123456789"), 0xcbf43926u32);
    assert_eq!(adler32(b"Wikipedia"), 0x11e60398u32);
}
#[test]
fn stored_stream_and_limit() {
    let bytes = [120u8,1u8,1u8,3u8,0u8,252u8,255u8,97u8,98u8,99u8,2u8,77u8,1u8,39u8];
    assert_eq!(inflate(&bytes,3usize).unwrap(), b"abc"[..].to_vec());
    assert!(inflate(&bytes,2usize).is_err());
}
#[test]
fn rejects_bad_png_and_zlib() {
    assert!(decode(b"not a PNG").is_err());
    assert!(inflate(b"bad", 10usize).is_err());
    assert!(inflate(&[0u8;6],10usize).is_err());
}

struct OutputBits { data: Vec<u8>, value: u8, count: u8 }
impl OutputBits {
    fn write(&mut self, value: u32, count: u8) {
        let mut bit = 0u8;
        while bit < count {
            self.value |= (((value >> bit) & 1u32) as u8) << self.count;
            self.count += 1u8;
            if self.count == 8u8 { self.data.push(self.value); self.count = 0u8; self.value = 0u8; }
            bit += 1u8;
        }
    }
    fn reverse(&mut self, value: u32, count: u8) {
        let mut bit = count;
        while bit > 0u8 { bit -= 1u8; self.write((value >> bit) & 1u32,1u8); }
    }
    fn literal(&mut self, symbol: u32) {
        if symbol <= 143u32 { self.reverse(48u32 + symbol,8u8); }
        else if symbol <= 255u32 { self.reverse(400u32 + symbol - 144u32,9u8); }
        else if symbol <= 279u32 { self.reverse(symbol - 256u32,7u8); }
        else { self.reverse(192u32 + symbol - 280u32,8u8); }
    }
    fn finish(mut self) -> Vec<u8> {
        if self.count != 0u8 { self.data.push(self.value); }
        self.data
    }
}

fn push32(out: &mut Vec<u8>, value: u32) {
    out.push((value >> 24) as u8); out.push((value >> 16) as u8);
    out.push((value >> 8) as u8); out.push(value as u8);
}
fn hash3(data: &[u8], pos: usize) -> usize {
    ((data[pos] as usize * 251usize + data[pos + 1usize] as usize) * 251usize + data[pos + 2usize] as usize) % 65536usize
}
fn deflate_fixed(raw: &[u8]) -> Vec<u8> {
    let mut bits = OutputBits { data: Vec::new(), value: 0u8, count: 0u8 };
    bits.write(3u32,3u8);
    let mut positions = vec![raw.len();65536usize];
    let mut pos = 0usize;
    while pos < raw.len() {
        let mut length = 0usize;
        let mut distance = 0usize;
        if raw.len() - pos >= 3usize {
            let hash = hash3(raw,pos);
            let previous = positions[hash];
            positions[hash] = pos;
            if previous < pos && pos - previous <= 32768usize {
                distance = pos - previous;
                while length < 258usize && length < raw.len() - pos && raw[previous + length] == raw[pos + length] { length += 1usize; }
            }
        }
        if length >= 3usize {
            let mut code = 0usize;
            while code + 1usize < LENGTH_BASE.len() && LENGTH_BASE[code + 1usize] <= length { code += 1usize; }
            bits.literal(code as u32 + 257u32);
            bits.write((length - LENGTH_BASE[code]) as u32,LENGTH_EXTRA[code]);
            code = 0usize;
            while code + 1usize < DISTANCE_BASE.len() && DISTANCE_BASE[code + 1usize] <= distance { code += 1usize; }
            bits.reverse(code as u32,5u8);
            bits.write((distance - DISTANCE_BASE[code]) as u32,DISTANCE_EXTRA[code]);
            let stop = pos + length;
            pos += 1usize;
            while pos < stop {
                if raw.len() - pos >= 3usize { positions[hash3(raw,pos)] = pos; }
                pos += 1usize;
            }
        } else { bits.literal(raw[pos] as u32); pos += 1usize; }
    }
    bits.literal(256u32);
    let mut compressed = vec![120u8,1u8];
    compressed.extend_from_slice(&bits.finish());
    push32(&mut compressed,adler32(raw));
    compressed
}
fn chunk(out: &mut Vec<u8>, name: &[u8], contents: &[u8]) {
    push32(out,contents.len() as u32);
    let mut body = name.to_vec();
    body.extend_from_slice(contents);
    let crc = crc32(&body);
    out.extend_from_slice(&body);
    push32(out,crc);
}

/// Encode the actual framebuffer with a small deterministic LZ77/fixed-Huffman writer.
pub fn encode(width: usize, height: usize, pixels: &[u32]) -> Result<Vec<u8>,String> {
    if width == 0usize || height == 0usize || width > MAX_AXIS || height > MAX_AXIS || width * height > MAX_PIXELS || pixels.len() != width * height {
        return Err("invalid PNG output dimensions".to_string());
    }
    let mut raw = Vec::<u8>::new();
    let mut row = 0usize;
    while row < height {
        raw.push(0u8);
        let mut col = 0usize;
        while col < width {
            let value = pixels[row * width + col];
            raw.push((value >> 16) as u8); raw.push((value >> 8) as u8);
            raw.push(value as u8); raw.push((value >> 24) as u8);
            col += 1usize;
        }
        row += 1usize;
    }
    let compressed = deflate_fixed(&raw);
    let mut header = Vec::<u8>::new();
    push32(&mut header,width as u32); push32(&mut header,height as u32);
    header.extend_from_slice(&[8u8,6u8,0u8,0u8,0u8]);
    let mut result = vec![137u8,80u8,78u8,71u8,13u8,10u8,26u8,10u8];
    chunk(&mut result,b"IHDR",&header);
    chunk(&mut result,b"IDAT",&compressed);
    chunk(&mut result,b"IEND",&[0u8;0]);
    if result.len() > MAX_FILE { return Err("PNG encoded file exceeds 32 MiB policy".to_string()); }
    Ok(result)
}

#[test]
fn encoder_roundtrip_with_alpha() {
    let pixels = [0xffdd1122u32,0x8055aa33u32,0u32,0xfffafafau32];
    let encoded = encode(2usize,2usize,&pixels).unwrap();
    let image = decode(&encoded).unwrap();
    assert_eq!(image.width,2usize); assert_eq!(image.height,2usize);
    assert_eq!(image.pixels,pixels[..].to_vec());
}
