#[test]
fn rejects_adler_and_backward_distance() {
    let bytes = [120u8,1u8,1u8,3u8,0u8,252u8,255u8,97u8,98u8,99u8,2u8,77u8,1u8,38u8];
    assert!(inflate(&bytes,3usize).is_err());
    let mut bits = OutputBits { data: Vec::new(), value:0u8,count:0u8 };
    bits.write(3u32,3u8); bits.literal(257u32); bits.reverse(0u32,5u8); bits.literal(256u32);
    let mut stream = vec![120u8,1u8]; stream.extend_from_slice(&bits.finish()); push32(&mut stream,1u32);
    assert!(inflate(&stream,3usize).is_err());
}

#[test]
fn incomplete_huffman_trees_reject() {
    assert!(Huffman::build(&[2u8,2u8]).is_err());
    assert!(Huffman::build(&[2u8]).is_err());
    assert!(Huffman::build(&[1u8]).is_ok());
    assert!(Huffman::build(&[1u8,1u8,1u8]).is_err());
}
#[test]
fn empty_block_work_is_bounded() {
    let stream = [120u8,1u8,0u8,0u8,0u8,255u8,255u8,0u8,0u8,0u8,255u8,255u8,1u8,0u8,0u8,255u8,255u8,0u8,0u8,0u8,1u8];
    assert!(inflate_limited(&stream,0usize,2usize).is_err());
    assert!(inflate_limited(&stream,0usize,3usize).unwrap().is_empty());
}
#[test]
fn idat_mutations_with_valid_crc_return_without_traps() {
    let base = encode(2usize,1usize,&[0xff123456u32,0x8078abcdu32]).unwrap();
    let size = u32be(&base,33usize) as usize;
    let crc_at = 41usize + size;
    let mut trial = 0usize;
    while trial < 16usize {
        let mut bytes = base.clone();
        let index = 41usize + trial % size;
        bytes[index] ^= 1u8 << (trial % 8usize);
        let crc = crc32(&bytes[37usize..crc_at]);
        bytes[crc_at] = (crc >> 24) as u8; bytes[crc_at + 1usize] = (crc >> 16) as u8;
        bytes[crc_at + 2usize] = (crc >> 8) as u8; bytes[crc_at + 3usize] = crc as u8;
        match decode(&bytes) {
            Ok(image) => { assert_eq!(image.width,2usize); assert_eq!(image.height,1usize); assert_eq!(image.pixels.len(),2usize); },
            Err(_) => (),
        }
        trial += 1usize;
    }
}
