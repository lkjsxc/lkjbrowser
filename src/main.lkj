//! lkjbrowser: native UI, navigation and rendering are lkjscript.
mod crypto;
mod net;
mod resources;
mod font;
mod paint;
mod chrome;
mod html;
mod css;
mod layout;
mod wayland;
mod png;
mod jpeg;
mod gif;
mod images;
mod typefaces;

use font::Font;
use typefaces::Fonts;
use paint::Canvas;
use wayland::Event;
// The page runs from under the toolbar to the window edge; chrome overlays, it takes no strip or gutter.
const TOP: i32 = chrome::HEIGHT;
const BOTTOM: i32 = 0i32;

// Intrinsic image sizes can move text that was already visible, including when
// the same source occurs earlier in the document. Track a text-node position,
// not a fragment index: changing a float's width may split that text differently.
#[derive(Copy,Clone)]
struct ImageScrollAnchor { node:usize, byte_offset:usize, screen_top:i32 }
fn image_scroll_anchor(page:&layout::Page,scroll:i32,viewport_height:i32)->Option<ImageScrollAnchor>{
    // Initial navigation must keep the top edge, even when its first image grows.
    if scroll<=0i32 || viewport_height<=0i32{return None;}
    let mut selected=page.commands.len();
    let mut top=2147483647i32;let mut left=2147483647i32;
    let mut index=0usize;
    while index<page.commands.len(){
        if let layout::Command::Text(run)=&page.commands[index]{
            if !run.text.is_empty() && run.width>0i32 && run.height>0i32
                && run.x<page.width && run.x as i64+run.width as i64>0i64
                && run.top as i64+run.height as i64>scroll as i64
                && (run.top as i64)<scroll as i64+viewport_height as i64
                && (run.top<top || (run.top==top && run.x<left)){
                selected=index;top=run.top;left=run.x;
            }
        }
        index+=1usize;
    }
    if selected==page.commands.len(){return None;}
    if let layout::Command::Text(run)=&page.commands[selected]{
        let mut byte_offset=0usize;let mut before=0usize;
        while before<selected{
            if let layout::Command::Text(previous)=&page.commands[before]{
                if previous.node==run.node{byte_offset+=previous.text.len();}
            }
            before+=1usize;
        }
        return Some(ImageScrollAnchor{node:run.node,byte_offset,screen_top:run.top-scroll});
    }
    None
}
fn image_anchor_scroll(page:&layout::Page,anchor:ImageScrollAnchor)->Option<i32>{
    let mut byte_offset=0usize;
    for command in &page.commands{
        if let layout::Command::Text(run)=command{
            if run.node==anchor.node{
                let end=byte_offset+run.text.len();
                if byte_offset<=anchor.byte_offset && anchor.byte_offset<end{
                    let scroll=(run.top as i64-anchor.screen_top as i64).max(0i64).min(2147483647i64);
                    return Some(scroll as i32);
                }
                byte_offset=end;
            }
        }
    }
    None
}

fn fonts(world:&mut World,directory:&str)->Result<Fonts,String>{typefaces::load(world,directory)}
fn escape(value:&str)->String {
    value.replace('&',"&amp;").replace('<',"&lt;").replace('>',"&gt;").replace('"',"&quot;")
}
fn error_html(address:&str,problem:&str)->String{
    let host=match net::parse(address){Ok(url)=>url.host,Err(_)=>address.to_string()};
    let lower=problem.to_ascii_lowercase();
    let explanation=if lower.contains("has expired"){
        format!("The certificate for {} has expired.",host)
    }else if lower.contains("not valid yet"){
        format!("The certificate for {} is not valid yet.",host)
    }else if lower.contains("different host name"){
        format!("The certificate for {} does not match that host name.",host)
    }else if lower.contains("self-signed"){
        format!("The certificate for {} is self-signed and is not trusted.",host)
    }else if lower.contains("trusted root"){
        format!("The certificate issuer for {} is not trusted.",host)
    }else if lower.contains("unsupported") && (lower.contains("constraint") || lower.contains("critical")){
        format!("The certificate for {} uses a constraint this browser cannot check.",host)
    }else if lower.contains("invalid signature") || lower.contains("signature did not verify"){
        format!("The certificate or handshake signature from {} is wrong.",host)
    }else if problem.contains("ECONNREFUSED"){
        "The server is not accepting connections at this address. Check the address or try again later.".to_string()
    }else if problem.contains("deadline") || problem.contains("ETIMEDOUT"){
        "The server took too long to respond. Try again later.".to_string()
    }else if problem.contains("Open regular file") && (problem.contains("EINVAL") || problem.contains("ELOOP")){
        "This address does not point to a regular file. Choose a normal file and try again.".to_string()
    }else if problem.contains("ENOENT"){
        "The file or folder could not be found. Check the path and try again.".to_string()
    }else{problem.to_string()};
    format!("<!doctype html><html><head><title>Unable to open this page</title><style>{}</style></head><body><div class=\"sheet\"><p class=\"mark warn\">Page not opened</p><h1>This page could not be opened.</h1><p class=\"lead\">{}</p><div class=\"rule\"></div><div class=\"row\"><h2>Address</h2><p class=\"quiet\">{}</p></div><div class=\"rule\"></div><div class=\"row\"><p><a href=\"{}\">Try again</a> &nbsp;·&nbsp; <a href=\"about:welcome\">Start page</a></p></div></div></body></html>",OWN_PAGE_STYLE,escape(explanation.as_str()),escape(address),escape(address))
}
// The browser's own pages share the toolbar's palette: ink, quiet ink, hairline, one accent, one warning.
const OWN_PAGE_STYLE:&str="body {margin:0;background:#ffffff;color:#1b2a32;font-size:17px;line-height:1.55;} .sheet {max-width:600px;margin:0 auto;padding:72px 24px 48px 24px;} .mark {color:#0b7a87;font-size:14px;font-weight:bold;margin:0 0 12px 0;} .warn {color:#ae422b;} h1 {font-size:40px;line-height:1.15;margin:0 0 16px 0;} .lead {font-size:20px;line-height:1.45;color:#5d717b;margin:0 0 40px 0;} .rule {height:1px;background:#d8e0e4;} .row {padding:18px 0 18px 0;} h2 {font-size:16px;margin:0 0 4px 0;} p {margin:0;} .quiet {color:#5d717b;} a {color:#0b7a87;}";
fn welcome()->String{
    format!("<!doctype html><html><head><title>lkjbrowser</title><style>{}</style></head><body><div class=\"sheet\"><p class=\"mark\">lkjbrowser</p><h1>A clear place to read.</h1><p class=\"lead\">Web pages, links and pictures work here. Scripts, forms and sign-ins do not.</p><div class=\"rule\"></div><div class=\"row\"><h2>Open a page</h2><p class=\"quiet\">Click the address field or press <strong>Ctrl+L</strong>, type an address and press Enter. Try <a href=\"https://example.com/\">example.com</a>.</p></div><div class=\"rule\"></div><div class=\"row\"><h2>Move around</h2><p class=\"quiet\">Scroll with the wheel, the arrow keys or Page Up and Page Down. Click a link to follow it. The arrows in the toolbar go back and forward, and <strong>Ctrl+R</strong> loads the page again.</p></div><div class=\"rule\"></div><div class=\"row\"><h2>Close</h2><p class=\"quiet\">Press <strong>Ctrl+Q</strong> or click the cross in the toolbar.</p></div></div></body></html>",OWN_PAGE_STYLE)
}
fn fit(font:&Font,text:&str,size:i32,max_width:i32)->String{
    let mut total=0i32;for c in text.chars(){total+=font.advance(c as u32,size);}
    if total<=max_width{return text.to_string();}
    let budget=(max_width-font.advance(8230u32,size)).max(0i32);
    let mut out=String::new();let mut width=0i32;
    for c in text.chars(){
        let next=font.advance(c as u32,size);
        if width+next>budget{break;}out.push(c);width+=next;
    }
    out.push('…');out
}
struct Modifiers {shift:u8,ctrl:u8}
impl Modifiers{
    fn update(&mut self,key:u32,pressed:bool)->bool{
        let mask=if key==42u32 || key==29u32{1u8}else{2u8};
        if key==42u32 || key==54u32{
            if pressed{self.shift|=mask;}else{self.shift&=!mask;}true
        }else if key==29u32 || key==97u32{
            if pressed{self.ctrl|=mask;}else{self.ctrl&=!mask;}true
        }else{false}
    }
}
struct HistoryEntry {url:String,allow_file:bool}
struct LoadedImage { src:String,image:png::Image }
struct Browser {
    fonts:Fonts,page:layout::Page,document:html::Document,computed:Vec<css::Style>,url:String,address:String,source:String,title:String,status:String,
    width:i32,height:i32,scroll:i32,editing:bool,select_all:bool,modifiers:Modifiers,
    history:Vec<HistoryEntry>,history_at:usize,hover:String,dns:String,images:Vec<LoadedImage>,image_sizes:Vec<layout::ImageSize>,file_authority:bool,
    trust_file:String,paint_started:Option<usize>,styles:String,image_attempted:Vec<String>,chrome:chrome::State,
}
impl Browser {
    fn new(fonts:Fonts,width:i32,height:i32,dns:String)->Browser{
        let document=html::parse("<html><body></body></html>");
        let page=layout::build_in_viewport(&document,width,width,height-TOP-BOTTOM,&fonts.normal,&fonts.bold,&fonts.italic,&fonts.bolditalic);
        let computed=css::compute_viewport(&document,width,height-TOP-BOTTOM);
        Browser {fonts,page,document,computed,url:String::new(),address:String::new(),source:String::new(),
            title:String::new(),status:String::new(),width,height,scroll:0i32,editing:false,
            select_all:false,modifiers:Modifiers{shift:0u8,ctrl:0u8},history:Vec::new(),history_at:0usize,
            hover:String::new(),dns,images:Vec::new(),image_sizes:Vec::new(),file_authority:true,
            trust_file:net::SYSTEM_TRUST.to_string(),paint_started:None,styles:String::new(),image_attempted:Vec::new(),chrome:chrome::State::new()}
    }
    fn max_scroll(&self)->i32{
        let value=self.page.height-(self.height-TOP-BOTTOM);
        if value>0i32{value}else{0i32}
    }
    fn move_scroll(&mut self,amount:i32){
        let max=self.max_scroll();
        self.scroll=(self.scroll+amount).max(0i32).min(max);
    }
    fn rebuild_document(&mut self){
        let mut document=html::parse(self.source.as_str());
        document.styles=self.styles.clone();
        self.title=document.title.clone();
        self.computed=css::compute_viewport(&document,self.width,self.height-TOP-BOTTOM);
        self.document=document;
    }
    fn relayout(&mut self){
        self.page=layout::build_styled_faces(&self.document,&self.computed,self.width,&self.fonts.normal,&self.fonts.bold,&self.fonts.italic,&self.fonts.bolditalic,&self.fonts.mono,&self.fonts.monobold,&self.fonts.monoitalic,&self.fonts.monobolditalic,&self.image_sizes);
        self.scroll=self.scroll.min(self.max_scroll());
    }
    fn relayout_images(&mut self){
        let anchor=image_scroll_anchor(&self.page,self.scroll,self.height-TOP-BOTTOM);
        self.relayout();
        if let Some(saved)=anchor{
            if let Some(scroll)=image_anchor_scroll(&self.page,saved){
                self.scroll=scroll.min(self.max_scroll());
            }
        }
    }

    fn navigate(&mut self,world:&mut World,address:&str,remember:bool){
        self.navigate_authorized(world,address,remember,true);
    }
    fn local_files_allowed(&self)->bool{
        (self.url.starts_with("file://") && self.file_authority) || self.url=="about:welcome"
    }
    fn navigate_authorized(&mut self,world:&mut World,address:&str,remember:bool,allow_file:bool){
        let mut clock=world.clock();self.paint_started=Some(clock.nanoseconds().unwrap());
        let normalized=if address=="about:welcome"{address.to_string()}else{net::entered_address(address)};
        let address=normalized.as_str();
        self.file_authority=allow_file;
        let mut final_address=address.to_string();
        let source=if address=="about:welcome"{
            self.status="Ready".to_string();welcome()
        }else{
            match net::fetch_with_trust(world,address,self.dns.as_str(),allow_file,self.trust_file.as_str()){
                Ok(response)=>{
                    final_address=response.url;
                    world.stdout().write(format!("HTTP_RESPONSE status={} bytes={} url={}\n",response.status,response.body.len(),final_address).as_bytes());
                    self.status=if final_address.starts_with("https://"){"Verified HTTPS".to_string()}else{String::new()};
                    match net::document_text(&response.body,response.content_type.as_str()){
                        Ok(text)=>{
                            if response.content_type.to_ascii_lowercase().starts_with("text/plain"){
                                format!("<html><head><title>Text document</title></head><body><pre>{}</pre></body></html>",escape(text.as_str()))
                            }else{text}
                        }
                        Err(problem)=>{
                            self.status="Unable to load this address".to_string();
                            world.stdout().write(format!("NAV_ERROR {}: {}\n",address,problem).as_bytes());
                            error_html(address,problem.as_str())
                        }
                    }
                }
                Err(problem)=>{
                    self.status="Unable to load this address".to_string();
                    world.stdout().write(format!("NAV_ERROR {}: {}\n",address,problem).as_bytes());
                    error_html(address,problem.as_str())
                }
            }
        };
        self.source=source;self.url=final_address;self.address=self.url.clone();
        self.images.clear();self.image_sizes.clear();self.image_attempted.clear();
        self.load_styles(world);
        self.rebuild_document();
        self.scroll=0i32;self.editing=false;self.select_all=false;self.hover.clear();
        self.relayout();
        self.load_images(world);
        if let Some((_,fragment))=self.url.as_str().split_once('#'){
            self.scroll=self.page.anchor(fragment).max(0i32).min(self.max_scroll());
        }
        if remember {
            if !self.history.is_empty(){self.history.truncate(self.history_at+1usize);}
            self.history.push(HistoryEntry{url:self.url.clone(),allow_file});self.history_at=self.history.len()-1usize;
        }
    }
    fn load_styles(&mut self,world:&mut World){
        let allowed=self.local_files_allowed();
        self.styles=resources::stylesheets(world,self.source.as_str(),self.url.as_str(),self.dns.as_str(),allowed,self.trust_file.as_str(),self.width);
    }

    fn load_images(&mut self,world:&mut World){
        let allowed=self.local_files_allowed();
        loop{
            let mut sources:Vec<String>=Vec::new();
            for command in &self.page.commands{
                if let layout::Command::Image(img)=command{
                    if !img.src.is_empty() && img.width>0 && img.height>0
                        && !sources.contains(&img.src) && !self.image_attempted.contains(&img.src)
                        && img.y+img.height>self.scroll && img.y<self.scroll+self.height-TOP-BOTTOM{
                        sources.push(img.src.clone());
                    }
                }
            }
            if sources.is_empty(){break;}
            let mut changed=false;
            for source in sources{
                self.image_attempted.push(source.clone());
                let url=net::resolve(self.url.as_str(),source.as_str());
                if self.url.starts_with("https://") && !url.starts_with("https://"){continue;}
                match net::fetch_with_trust(world,url.as_str(),self.dns.as_str(),allowed,self.trust_file.as_str()){
                    Ok(response)=>{
                        match images::decode(&response.body){
                            Ok(image)=>{
                                world.stdout().write(format!("IMAGE decoded width={} height={} url={}\n",image.width,image.height,url).as_bytes());
                                self.image_sizes.push(layout::ImageSize{src:source.clone(),width:image.width as i32,height:image.height as i32});
                                self.images.push(LoadedImage{src:source,image});
                                changed=true;
                            }
                            Err(problem)=>{
                                if response.content_type.to_ascii_lowercase().contains("image/svg+xml"){
                                    if let Some((width,height))=images::svg_dimensions(&response.body){
                                        self.image_sizes.push(layout::ImageSize{src:source.clone(),width,height});
                                        changed=true;
                                    }
                                }
                                world.stdout().write(format!("IMAGE unavailable {} url={}\n",problem,url).as_bytes());
                            }
                        }
                    }
                    Err(problem)=>{world.stdout().write(format!("IMAGE unavailable {} url={}\n",problem,url).as_bytes());}
                }
            }
            if changed{self.relayout_images();}
        }
    }

    fn follow(&mut self,world:&mut World,href:&str){
        if href.starts_with('#'){
            self.scroll=self.page.anchor(&href[1..]).max(0i32).min(self.max_scroll());
            self.url=net::resolve(self.url.as_str(),href);self.address=self.url.clone();
        }else{
            let address=if href.starts_with("about:"){href.to_string()}else{net::resolve(self.url.as_str(),href)};
            let allowed=self.local_files_allowed();
            self.navigate_authorized(world,address.as_str(),true,allowed);
        }
    }
    fn back(&mut self,world:&mut World){
        if self.history_at>0usize{
            self.history_at-=1usize;let address=self.history[self.history_at].url.clone();
            let allowed=self.history[self.history_at].allow_file;
            self.navigate_authorized(world,address.as_str(),false,allowed);
        }
    }
    fn forward(&mut self,world:&mut World){
        if self.history_at+1usize<self.history.len(){
            self.history_at+=1usize;let address=self.history[self.history_at].url.clone();
            let allowed=self.history[self.history_at].allow_file;
            self.navigate_authorized(world,address.as_str(),false,allowed);
        }
    }
    fn reload(&mut self,world:&mut World){
        let address=self.url.clone();let allowed=self.file_authority;self.navigate_authorized(world,address.as_str(),false,allowed);
    }
    fn chrome_view(&self)->chrome::View{
        // The bubble shows where a link leads, not how the page spelled it.
        let hover=if self.hover.is_empty() || self.hover.starts_with("about:"){self.hover.clone()}
            else{net::resolve(self.url.as_str(),self.hover.as_str())};
        chrome::View{width:self.width,height:self.height,url:self.url.clone(),address:self.address.clone(),
            hover:hover,verified:self.status=="Verified HTTPS",
            failed:self.status=="Unable to load this address",editing:self.editing,select_all:self.select_all,
            can_back:self.history_at>0usize,can_forward:self.history_at+1usize<self.history.len(),
            scroll:self.scroll,max_scroll:self.max_scroll(),page_height:self.page.height}
    }
    /// The address this event is about to fetch, so a loading frame can be shown before the fetch blocks.
    fn about_to_load(&self,event:Event)->String{
        match event{
            Event::Key(key,true)=>{
                if self.modifiers.ctrl!=0u8 && key==19u32{return self.url.clone();}
                if self.editing && key==28u32{return net::entered_address(self.address.as_str());}
                if !self.editing && self.modifiers.ctrl!=0u8 && key==105u32 && self.history_at>0usize{
                    return self.history[self.history_at-1usize].url.clone();
                }
            }
            Event::Click(x,y)=>{
                let view=self.chrome_view();
                let mut probe=chrome::State::new();
                if let chrome::Action::None=probe.press(&view,x,y){
                    let href=self.page.hit(x,y-TOP+self.scroll);
                    if !href.is_empty() && !href.starts_with('#') && !href.starts_with("about:"){return net::resolve(self.url.as_str(),href.as_str());}
                }
            }
            Event::Release(x,y)=>{
                let view=self.chrome_view();
                match self.chrome.release_action(&view,x,y){
                    chrome::Action::Back=>{return self.history[self.history_at-1usize].url.clone();}
                    chrome::Action::Forward=>{return self.history[self.history_at+1usize].url.clone();}
                    chrome::Action::Reload=>{return self.url.clone();}
                    _=>{}
                }
            }
            _=>{}
        }
        String::new()
    }
    fn key(&mut self,world:&mut World,key:u32,pressed:bool)->bool{
        if self.modifiers.update(key,pressed){return true;}
        if !pressed{return true;}
        if self.modifiers.ctrl!=0u8 && (key==16u32 || key==17u32){return false;}
        if self.modifiers.ctrl!=0u8 && key==38u32{self.editing=true;self.select_all=true;return true;}
        if self.modifiers.ctrl!=0u8 && key==19u32{self.reload(world);return true;}
        if self.editing{
            if key==1u32{self.editing=false;self.select_all=false;self.address=self.url.clone();}
            else if key==28u32{
                let address=self.address.clone();self.navigate(world,address.as_str(),true);
            }else if key==14u32{
                if self.select_all {self.address.clear();self.select_all=false;}
                else if !self.address.is_empty(){
                    let mut last=0usize;let mut offset=0usize;
                    for c in self.address.as_str().chars(){last=offset;offset+=c.len_utf8();}
                    let shortened={self.address.as_str()[..last].to_string()};
                    self.address=shortened;
                }
            }else if self.modifiers.ctrl==0u8{
                let byte=wayland::key_ascii(key,self.modifiers.shift!=0u8);
                if byte>=32u8 && byte<127u8{
                    if self.select_all{self.address.clear();self.select_all=false;}
                    self.address.push(byte as char);
                }
            }
        }else{
            if key==108u32{self.move_scroll(72i32);}
            else if key==103u32{self.move_scroll(-72i32);}
            else if key==109u32 || key==57u32{let step=self.height-TOP-BOTTOM-48i32;self.move_scroll(step);}
            else if key==104u32{let step=-(self.height-TOP-BOTTOM-48i32);self.move_scroll(step);}
            else if key==102u32{self.scroll=0i32;}
            else if key==107u32{self.scroll=self.max_scroll();}
            else if key==105u32 && self.modifiers.ctrl!=0u8{self.back(world);}
        }
        true
    }
    fn toggle_disclosure(&mut self,node:usize){
        if node>=self.document.nodes.len() || self.document.nodes[node].tag!="details"{return;}
        if self.document.has_attribute(node,"open"){
            let mut attributes:Vec<html::Attribute>=Vec::new();
            for attribute in &self.document.nodes[node].attributes{
                if attribute.name!="open"{attributes.push(attribute.clone());}
            }
            self.document.nodes[node].attributes=attributes;
        }else{self.document.nodes[node].attributes.push(html::Attribute{name:"open".to_string(),value:String::new()});}
        self.computed=css::compute_viewport(&self.document,self.width,self.height-TOP-BOTTOM);
        self.relayout();
    }
    fn event(&mut self,world:&mut World,event:Event)->bool{
        match event{
            Event::Close=>false,
            Event::Scroll(delta)=>{self.move_scroll(delta);true}
            Event::Key(key,pressed)=>self.key(world,key,pressed),
            Event::Motion(x,y)=>{
                let view=self.chrome_view();
                self.hover=match self.chrome.motion(&view,x,y){
                    chrome::Action::Scroll(to)=>{self.scroll=to.max(0i32).min(self.max_scroll());String::new()}
                    chrome::Action::None=>self.page.hit(x,y-TOP+self.scroll),
                    _=>String::new(),
                };
                true
            }
            Event::Click(x,y)=>{
                let view=self.chrome_view();
                match self.chrome.press(&view,x,y){
                    chrome::Action::Edit=>{self.editing=true;self.select_all=true;}
                    chrome::Action::Scroll(to)=>{self.scroll=to.max(0i32).min(self.max_scroll());}
                    chrome::Action::None=>{
                        self.editing=false;
                        let href=self.page.hit(x,y-TOP+self.scroll);
                        if !href.is_empty(){self.follow(world,href.as_str());}
                        else if let Some(node)=self.page.disclosure_at(x,y-TOP+self.scroll){self.toggle_disclosure(node);}
                    }
                    _=>{}
                }
                true
            }
            Event::Release(x,y)=>{
                let view=self.chrome_view();
                match self.chrome.release(&view,x,y){
                    chrome::Action::Back=>{self.back(world);}
                    chrome::Action::Forward=>{self.forward(world);}
                    chrome::Action::Reload=>{self.reload(world);}
                    chrome::Action::Close=>{return false;}
                    _=>{}
                }
                true
            }
            Event::Leave=>{self.chrome.leave();self.hover.clear();true}
            Event::Resize(_,_)=>true, // First slice advertises fixed minimum/maximum size.
        }
    }
    fn paint(&mut self)->Canvas{
        let mut canvas=Canvas::new(self.width as usize,self.height as usize,self.page.background);
        let mut i=0usize;
        while i<self.page.commands.len(){
            match &self.page.commands[i]{
                layout::Command::Rect(r)=>{
                    canvas.rect(r.x,r.y+TOP-self.scroll,r.width,r.height,r.color);
                }
                layout::Command::Text(run)=>{
                    let baseline=run.baseline+TOP-self.scroll;
                    if baseline+run.size>TOP && run.top+TOP-self.scroll<self.height-BOTTOM{
                        let font=if run.monospace {
                            if run.bold && run.italic{&mut self.fonts.monobolditalic}
                            else if run.bold{&mut self.fonts.monobold}else if run.italic{&mut self.fonts.monoitalic}else{&mut self.fonts.mono}
                        }else if run.bold && run.italic{&mut self.fonts.bolditalic}
                            else if run.bold{&mut self.fonts.bold}else if run.italic{&mut self.fonts.italic}else{&mut self.fonts.normal};
                        canvas.text(font,run.text.as_str(),run.size,run.x,baseline,run.color);
                    }
                }
                layout::Command::Image(img)=>{
                    let y=img.y+TOP-self.scroll;
                    let mut found=false;
                    for loaded in &self.images{
                        if loaded.src==img.src{
                            canvas.image(loaded.image.width,loaded.image.height,&loaded.image.pixels,img.x,y,img.width,img.height);
                            found=true;break;
                        }
                    }
                    if !found{
                        canvas.rect(img.x,y,img.width,img.height,0xe6eef0u32);
                        canvas.rect(img.x,y,img.width,1i32,0xbacbd1u32);
                        let label=fit(&self.fonts.normal,img.alt.as_str(),15i32,img.width-24i32);
                        canvas.text(&mut self.fonts.normal,label.as_str(),15i32,img.x+12i32,y+28i32,0x54717du32);
                    }
                }
            }
            i+=1;
        }
        // Chrome is painted last, so scrolled content cannot overlap it.
        let view=self.chrome_view();
        chrome::paint(&self.chrome,&mut canvas,&mut self.fonts.normal,&view);
        canvas
    }
    fn replay(&mut self,world:&mut World,script:&str)->Result<(),String>{
        for line in script.lines(){
            let line=std::str::trim_ascii(line);
            if line.is_empty() || line.starts_with('#'){continue;}
            let (command,arg)=line.split_once(' ').unwrap_or((line,""));
            if command=="scroll"{
                let delta=match arg.parse::<i32>(){Ok(n)=>n,Err(_)=>return Err("Invalid script scroll".to_string())};
                self.event(world,Event::Scroll(delta));
            }else if command=="key"{
                let code=match arg.parse::<u32>(){Ok(n)=>n,Err(_)=>return Err("Invalid script key".to_string())};
                self.event(world,Event::Key(code,true));self.event(world,Event::Key(code,false));
            }else if command=="down" || command=="up"{
                let code=match arg.parse::<u32>(){Ok(n)=>n,Err(_)=>return Err("Invalid held key".to_string())};
                self.event(world,Event::Key(code,command=="down"));
            }else if command=="click" || command=="press" || command=="move"{
                // click is press and release at one point; press alone holds the button; move only moves.
                let (a,b)=match arg.split_once(' '){Some(p)=>p,None=>return Err("Script pointer command needs x y".to_string())};
                let x=a.parse::<i32>().unwrap();let y=b.parse::<i32>().unwrap();
                if command=="move"{self.event(world,Event::Motion(x,y));}
                else{
                    self.event(world,Event::Click(x,y));
                    if command=="click"{self.event(world,Event::Release(x,y));}
                }
            }else if command=="loading"{self.chrome.loading=arg.to_string();}else if command=="open"{self.navigate(world,arg,true);}
            else if command=="follow"{self.follow(world,arg);}
            else if command=="back"{self.back(world);}
            else if command=="address"{self.editing=true;self.address=arg.to_string();self.select_all=false;}
            else{return Err(format!("Unknown input script command: {}",command));}
        }
        Ok(())
    }
}
struct Options {
    url:String,screenshot:String,dump:String,script:String,live_script:String,font_dir:String,dns:String,trust_file:String,
    frame_file:String,port:u16,width:i32,height:i32,scroll:i32,max_ms:usize,help:bool,
}
fn options(args:Vec<Vec<u8>>)->Result<Options,String>{
    let mut opt=Options{url:"about:welcome".to_string(),screenshot:String::new(),dump:String::new(),
        script:String::new(),live_script:String::new(),font_dir:String::new(),dns:String::new(),frame_file:String::new(),trust_file:net::SYSTEM_TRUST.to_string(),
        port:0u16,width:1000i32,height:760i32,scroll:0i32,max_ms:0usize,help:false};
    let mut i=0usize;
    while i<args.len(){
        let arg=net::text(&args[i]);i+=1;
        if arg=="--help" || arg=="-h"{opt.help=true;continue;}
        if arg=="--headless"{continue;}
        if arg.starts_with("--"){
            if i>=args.len(){return Err(format!("Missing value after {}",arg));}
            let value=net::text(&args[i]);i+=1;
            if arg=="--screenshot"{opt.screenshot=value;}
            else if arg=="--layout"{opt.dump=value;}
            else if arg=="--script"{opt.script=value;}
            else if arg=="--live-script"{opt.live_script=value;}
            else if arg=="--font-dir"{opt.font_dir=value;}
            else if arg=="--dns"{opt.dns=value;}
            else if arg=="--trust-file"{opt.trust_file=value;}
            else if arg=="--frame-file"{opt.frame_file=value;}
            else if arg=="--wayland"{opt.port=value.as_str().parse::<u16>().map_err(|_|->String{"Invalid bridge port".to_string()})?;}
            else if arg=="--width"{opt.width=value.as_str().parse::<i32>().map_err(|_|->String{"Invalid width".to_string()})?;}
            else if arg=="--height"{opt.height=value.as_str().parse::<i32>().map_err(|_|->String{"Invalid height".to_string()})?;}
            else if arg=="--scroll"{opt.scroll=value.as_str().parse::<i32>().map_err(|_|->String{"Invalid scroll".to_string()})?;}
            else if arg=="--max-ms"{opt.max_ms=value.as_str().parse::<usize>().map_err(|_|->String{"Invalid duration".to_string()})?;}
            else{return Err(format!("Unknown option {}",arg));}
        }else{opt.url=arg;}
    }
    if opt.width<320i32 || opt.width>4096i32 || opt.height<240i32 || opt.height>2160i32 {
        return Err("Viewport must be 320..4096 by 240..2160".to_string());
    }
    Ok(opt)
}
fn report_paint(world:&mut World,app:&mut Browser,kind:&str){
    if let Some(start)=app.paint_started{
        let mut clock=world.clock();let now=clock.nanoseconds().unwrap();
        world.stdout().write(format!("PAINT {} elapsed_us={} url={}\n",kind,(now-start)/1000usize,app.url).as_bytes());
        app.paint_started=None;
    }
}
fn save(world:&mut World,app:&mut Browser,opt:&Options,canvas:&Canvas)->Result<(),String>{
    if !opt.screenshot.is_empty(){if opt.screenshot.ends_with(".png"){
            let bytes=png::encode(canvas.width,canvas.height,&canvas.pixels)?;
            net::write_path(world,opt.screenshot.as_str(),&bytes)?;
        }else{net::write_path(world,opt.screenshot.as_str(),&canvas.ppm())?;}}
    if !opt.dump.is_empty(){
        let header=format!("URL {}\nVIEW {} {} SCROLL {}\nTITLE {}\nIMAGES {}\n",app.url,app.width,app.height,app.scroll,app.title,app.images.len());
        let result=format!("{}{}",header,app.page.dump());
        net::write_path(world,opt.dump.as_str(),result.as_bytes())?;
    }
    Ok(())
}
fn schedule(source:&str)->Result<Vec<(usize,String)>,String>{
    let mut result=Vec::new();let mut previous=0usize;
    for line in source.lines(){
        let line=std::str::trim_ascii(line);
        if !line.is_empty() && !line.starts_with('#'){
            let (time,action)=match line.split_once(' '){Some(pair)=>pair,None=>return Err("Live script requires milliseconds and action".to_string())};
            let ms=time.parse::<usize>().map_err(|_|->String{"Invalid live script timestamp".to_string()})?;
            if ms<previous{return Err("Live script timestamps must be ordered".to_string());}
            result.push((ms,action.to_string()));previous=ms;
        }
    }
    Ok(result)
}
fn run(world:&mut World)->Result<(),String>{
    let args=world.args();
    if !args.is_empty() && args[0]==b"--fetch-style"[..].to_vec(){return resources::style_worker(world,&args);}
    let opt=options(args)?;
    if opt.help{
        world.stdout().write(b"lkjbrowser [URL] [--headless] [--screenshot FILE.png] [--layout FILE] [--script FILE]\n  --wayland PORT --frame-file FILE  connect through the temporary descriptor bridge\n  --width N --height N --scroll N --max-ms N --font-dir DIR --dns IPV4\n  --trust-file FILE  use this explicit PEM trust bundle for all HTTPS origins\n  --live-script FILE  replay timestamped events while the Wayland window is open\nUse tools/wayland-run.sh URL on a real Wayland desktop.\n");
        return Ok(());
    }
    let faces=fonts(world,opt.font_dir.as_str())?;
    let mut app=Browser::new(faces,opt.width,opt.height,opt.dns.clone());
    app.trust_file=opt.trust_file.clone();
    app.navigate(world,opt.url.as_str(),true);
    app.move_scroll(opt.scroll);
    if !opt.script.is_empty(){let bytes=net::read_path(world,opt.script.as_str())?;app.replay(world,net::text(&bytes).as_str())?;}
    app.load_images(world);
    let mut canvas=app.paint();save(world,&mut app,&opt,&canvas)?;
    if opt.port==0u16 {
        report_paint(world,&mut app,"headless");
        world.stdout().write(format!("Rendered {}: {}x{}, document height {}, scroll {}\n",app.url,opt.width,opt.height,app.page.height,app.scroll).as_bytes());
        return Ok(());
    }
    if opt.frame_file.is_empty(){return Err("--wayland requires --frame-file".to_string());}
    let (root,name)=if opt.frame_file.starts_with('/'){("/", &opt.frame_file.as_str()[1..])}else{(".",opt.frame_file.as_str())};
    let mut dir=world.directory(root).map_err(|e:i64|->String{format!("Frame directory errno {}",e)})?;
    // Resize the same backing inode once, before wl_shm.create_pool. Later frames use seek/write only.
    let mut frame=dir.create(name).map_err(|e:i64|->String{format!("Create frame file errno {}",e)})?;
    frame.truncate(wayland::frame_file_size(opt.width as usize,opt.height as usize)).map_err(|e:i64|->String{format!("Frame size errno {}",e)})?;
    let slot_size=opt.width as usize*opt.height as usize*4usize;
    frame.seek((slot_size*2usize) as i64,0u8).unwrap();
    frame.write_all(&wayland::cursor_bytes()).unwrap();
    let title=format!("{} — lkjbrowser",app.title);
    let mut window=wayland::Wayland::open(world,opt.port,opt.width,opt.height,title.as_str())?;
    let mut window_title=app.title.clone();
    let timeline=if opt.live_script.is_empty(){Vec::new()}else{
        let bytes=net::read_path(world,opt.live_script.as_str())?;schedule(net::text(&bytes).as_str())?
    };
    let mut action_index=0usize;
    let mut clock=world.clock();let start=clock.nanoseconds().unwrap();
    let mut dirty=true;let mut alive=true;
    while alive{
        if dirty{
            let slot=if window.available(0u32){0u32}else{1u32};
            if window.available(slot){
                frame.seek((slot as usize*slot_size) as i64,0u8).unwrap();
                frame.write_all(&canvas.bgra()).unwrap();
                window.present(slot)?;
                report_paint(world,&mut app,"wayland-submit");
                dirty=false;
            }
        }
        if opt.max_ms>0usize && clock.nanoseconds().unwrap()-start>=opt.max_ms*1000000usize{break;}
        let events=window.poll(50usize)?;
        let mut changed=false;
        let elapsed=(clock.nanoseconds().unwrap()-start)/1000000usize;
        while action_index<timeline.len() && timeline[action_index].0<=elapsed{
            app.replay(world,timeline[action_index].1.as_str())?;
            world.stdout().write(format!("Script {}ms: {}\n",timeline[action_index].0,timeline[action_index].1).as_bytes());
            action_index+=1usize;changed=true;
        }
        for event in events{
            let loading=app.about_to_load(event);
            if !loading.is_empty(){
                // The fetch blocks this loop: show where we are going before it starts.
                app.chrome.loading=loading;
                let slot=if window.available(0u32){0u32}else{1u32};
                if window.available(slot){
                    frame.seek((slot as usize*slot_size) as i64,0u8).unwrap();
                    frame.write_all(&app.paint().bgra()).unwrap();
                    window.present(slot)?;
                }
                app.chrome.loading.clear();
            }
            if !app.event(world,event){alive=false;}
            if app.chrome.take_move(){window.start_move()?;}
            changed=true;
        }
        if changed{
            if window_title!=app.title{
                window.set_title(format!("{} — lkjbrowser",app.title).as_str())?;
                window_title=app.title.clone();
            }
            app.load_images(world);
            canvas=app.paint();save(world,&mut app,&opt,&canvas)?;dirty=true;
        }
    }
    world.stdout().write(format!("Wayland: sent {} messages, received {}, presented {} frames\n",window.sent_messages,window.received_messages,window.committed_frames).as_bytes());
    Ok(())
}
pub fn main(mut world:World){
    if let Err(problem)=run(&mut world){
        world.stderr().write(format!("lkjbrowser: {}\n",problem).as_bytes());
        world.set_exit_status(1u8);
    }
}

#[test]
fn both_modifier_keys_survive_one_release(){
    let mut modifiers=Modifiers{shift:0u8,ctrl:0u8};
    assert!(modifiers.update(42u32,true));
    assert!(modifiers.update(54u32,true));
    modifiers.update(42u32,false);assert!(modifiers.shift!=0u8);
    modifiers.update(54u32,false);assert_eq!(modifiers.shift,0u8);
    modifiers.update(29u32,true);modifiers.update(97u32,true);
    modifiers.update(29u32,false);assert!(modifiers.ctrl!=0u8);
    modifiers.update(97u32,false);assert_eq!(modifiers.ctrl,0u8);
}

fn anchor_test_browser(source:&str,width:i32)->Browser{
    let faces=Fonts{normal:font::metric_test_font(),bold:font::metric_test_font(),
        italic:font::metric_test_font(),bolditalic:font::metric_test_font(),
        mono:font::metric_test_font(),monobold:font::metric_test_font(),
        monoitalic:font::metric_test_font(),monobolditalic:font::metric_test_font()};
    let mut app=Browser::new(faces,width,500i32,String::new());
    app.source=source.to_string();app.styles=html::parse(source).styles;
    app.rebuild_document();app.relayout();app
}
fn anchor_test_text_top(page:&layout::Page,value:&str)->i32{
    for command in &page.commands{
        if let layout::Command::Text(run)=command{
            if run.text==value{return run.top;}
        }
    }
    assert!(false);0i32
}
#[test]
fn image_reflow_anchors_text_when_visible_source_also_occurs_above(){
    let mut app=anchor_test_browser("<style>body{margin:0;font-size:20px}p{margin:0;line-height:24px}img{display:block}</style><img src='same.gif'><div style='height:100px'></div><p>Reading position stays here.</p><img src='same.gif'><div style='height:900px'></div>",640i32);
    app.scroll=anchor_test_text_top(&app.page,"Reading")-5i32;
    let before_scroll=app.scroll;
    let mut above=0usize;let mut visible=0usize;
    for command in &app.page.commands{
        if let layout::Command::Image(img)=command{
            if img.y+img.height<=app.scroll{above+=1usize;}
            if img.y+img.height>app.scroll && img.y<app.scroll+app.height-TOP-BOTTOM{visible+=1usize;}
        }
    }
    assert_eq!(above,1usize);assert_eq!(visible,1usize);
    app.image_sizes.push(layout::ImageSize{src:"same.gif".to_string(),width:200i32,height:180i32});
    app.relayout_images();
    assert_eq!(anchor_test_text_top(&app.page,"Reading")-app.scroll,5i32);
    assert!(app.scroll>=before_scroll+100i32);
    let mut enlarged=0usize;
    for command in &app.page.commands{
        if let layout::Command::Image(img)=command{if img.height==180i32{enlarged+=1usize;}}
    }
    assert_eq!(enlarged,2usize);
}
#[test]
fn image_reflow_preserves_partly_clipped_unicode_fragment_after_rewrap(){
    let token="ΑΒΓΔΕΖΗΘΙΚΛΜΝΞΟΠΡΣΤΥΦΧΨΩαβγδεζηθικλμνξοπρστυφχψωАБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯабвгдежзийклмнопрстуфхцчшщъыьэюя";
    let source=format!("<style>body{{margin:0;font-size:20px;line-height:24px}}p{{margin:0}}img{{display:block}}</style><img src='same.gif'><div style='height:100px'></div><div><img src='same.gif' style='float:left'><p>{}</p></div><div style='height:900px'></div>",token);
    let mut app=anchor_test_browser(source.as_str(),320i32);
    let mut count=0usize;let mut marker=String::new();let mut old_fragment=String::new();
    for command in &app.page.commands{
        if let layout::Command::Text(run)=command{
            if count==3usize{
                marker=run.text.as_str().chars().next().unwrap().to_string();
                old_fragment=run.text.clone();app.scroll=run.top+2i32;
                break;
            }
            count+=1usize;
        }
    }
    assert!(!marker.is_empty());
    app.image_sizes.push(layout::ImageSize{src:"same.gif".to_string(),width:120i32,height:180i32});
    app.relayout_images();
    let mut found=false;
    for command in &app.page.commands{
        if let layout::Command::Text(run)=command{
            if run.text.contains(marker.as_str()){
                assert_ne!(run.text,old_fragment);
                assert_eq!(run.top-app.scroll,-2i32);found=true;break;
            }
        }
    }
    assert!(found);
}
#[test]
fn initial_image_reflow_keeps_document_top(){
    let mut app=anchor_test_browser("<style>body{margin:0}img{display:block}</style><img src='first.gif'><p>First text</p><div style='height:900px'></div>",640i32);
    assert_eq!(app.scroll,0i32);
    app.image_sizes.push(layout::ImageSize{src:"first.gif".to_string(),width:200i32,height:300i32});
    app.relayout_images();
    assert_eq!(app.scroll,0i32);
    assert!(anchor_test_text_top(&app.page,"First")>=300i32);
}
