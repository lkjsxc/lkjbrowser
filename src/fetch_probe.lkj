mod net;
pub fn main(mut world:World){
 let args=world.args();
 if args.len()!=2usize{world.set_exit_status(2u8);return;}
 let url=net::text(&args[0]);let path=net::text(&args[1]);
 match net::fetch(&mut world,url.as_str(),""){
  Ok(response)=>{net::write_path(&mut world,path.as_str(),&response.body).unwrap();world.stdout().write(format!("{} {} {} bytes {}\\n",response.status,response.content_type,response.body.len(),response.url).as_bytes());}
  Err(problem)=>{world.stderr().write(problem.as_bytes());world.set_exit_status(1u8);}
 }
}
