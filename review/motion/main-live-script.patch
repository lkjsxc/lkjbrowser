+#[test]
+fn live_script_ignores_blank_lines_and_comments(){
+    let lines=replay_lines("\n # proof\n scroll 120 \n\nkey 102\nclick 130 120\n");
+    assert_eq!(lines.len(),3usize);
+    assert_eq!(lines[0],"scroll 120");
+    assert_eq!(lines[1],"key 102");
+    assert_eq!(lines[2],"click 130 120");
+}
+
+#[test]
+fn live_script_requires_wayland_and_positive_finite_interval(){
+    assert!(options(vec!["--live-script".as_bytes().to_vec(),"events.txt".as_bytes().to_vec()]).is_err());
+    assert!(options(vec!["--wayland".as_bytes().to_vec(),"1234".as_bytes().to_vec(),"--live-script".as_bytes().to_vec(),"events.txt".as_bytes().to_vec(),"--script-interval-ms".as_bytes().to_vec(),"0".as_bytes().to_vec()]).is_err());
+    assert!(options(vec!["--script-interval-ms".as_bytes().to_vec(),"18446744073709551615".as_bytes().to_vec()]).is_err());
+    let opt=options(vec!["--wayland".as_bytes().to_vec(),"1234".as_bytes().to_vec(),"--live-script".as_bytes().to_vec(),"events.txt".as_bytes().to_vec(),"--script-interval-ms".as_bytes().to_vec(),"250".as_bytes().to_vec()]).unwrap();
+    assert_eq!(opt.script_interval_ms,250usize);
+    assert_eq!(opt.live_script,"events.txt");
+    let headless=options(vec!["--script".as_bytes().to_vec(),"events.txt".as_bytes().to_vec()]).unwrap();
+    assert_eq!(headless.port,0u16);
+    assert_eq!(headless.script,"events.txt");
