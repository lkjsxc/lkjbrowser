+// Test-only live replay keeps the ordinary headless --script behavior unchanged.
+fn replay_lines(script:&str)->Vec<String>{
+    let mut commands=Vec::new();
+    for line in script.lines(){
+        let line=std::str::trim_ascii(line);
+        if !line.is_empty() && !line.starts_with('#'){commands.push(line.to_string());}
+    }
+    commands
