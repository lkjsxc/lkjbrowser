+#[test]
+fn em_lengths_use_final_font_size_in_either_declaration_order() {
+    let doc = crate::html::parse("<body style='font-size:20px'><p style='margin-left:1em;padding-left:2em;width:4em;line-height:1.5em;font-size:40px'>Before</p><p style='font-size:40px;margin-left:1em;padding-left:2em;width:4em;line-height:1.5em'>After</p></body>");
+    let styles = compute(&doc);
+    let mut found = 0usize;
+    let mut i = 0usize;
+    while i < doc.nodes.len() {
+        if doc.nodes[i].tag == "p" {
+            assert_eq!(styles[i].font_size, 40);
+            assert_eq!(styles[i].margin_left, 40);
+            assert_eq!(styles[i].padding_left, 80);
+            assert_eq!(styles[i].width, 160);
+            assert_eq!(styles[i].line_height, 60);
+            assert_eq!(styles[i].line_height_scale, 0);
+            found += 1usize;
+        }
+        i += 1usize;
+    }
+    assert_eq!(found, 2usize);
+}
