text node=27 x=18 baseline=1393 top=1378 w=74 h=19 size=16 bold=false italic=false color=ff1769a4 href="./rfc5869" value="RFC 5869"
text node=28 x=92 baseline=1393 top=1378 w=392 h=19 size=16 bold=false italic=false color=ff263342 href="" value="                 Extract-and-Expand HKDF                May 2010"
rect x=18 y=1395 w=74 h=1 color=ff1769a4
text node=32 x=18 baseline=1465 top=1450 w=9 h=19 size=16 bold=false italic=false color=ff1769a4 href="#section-1" value="1"
text node=33 x=27 baseline=1465 top=1450 w=95 h=19 size=16 bold=false italic=false color=ff263342 href="" value=".  Introduction"
rect x=18 y=1467 w=9 h=1 color=ff1769a4
text node=34 x=18 baseline=1513 top=1498 w=503 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   A key derivation function (KDF) is a basic and essential component of"
text node=34 x=18 baseline=1537 top=1522 w=454 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   cryptographic systems.  Its goal is to take some source of initial"
text node=34 x=18 baseline=1561 top=1546 w=460 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   keying material and derive from it one or more cryptographically"
text node=34 x=18 baseline=1585 top=1570 w=144 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   strong secret keys."
text node=34 x=18 baseline=1633 top=1618 w=357 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   This document specifies a simple HMAC-based ["
text node=36 x=375 baseline=1633 top=1618 w=48 h=19 size=16 bold=false italic=false color=ff1769a4 href="#ref-HMAC" value="HMAC"
text node=37 x=423 baseline=1633 top=1618 w=151 h=19 size=16 bold=false italic=false color=ff263342 href="" value="] KDF, named HKDF,"
rect x=375 y=1635 w=48 h=1 color=ff1769a4
text node=37 x=18 baseline=1657 top=1642 w=455 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   which can be used as a building block in various protocols and"
text node=37 x=18 baseline=1681 top=1666 w=430 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   applications, and is already used in several IETF protocols,"
text node=37 x=18 baseline=1705 top=1690 w=85 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   including ["
text node=39 x=103 baseline=1705 top=1690 w=43 h=19 size=16 bold=false italic=false color=ff1769a4 href="#ref-IKEv2" value="IKEv2"
text node=40 x=146 baseline=1705 top=1690 w=16 h=19 size=16 bold=false italic=false color=ff263342 href="" value="], ["
text node=42 x=162 baseline=1705 top=1690 w=45 h=19 size=16 bold=false italic=false color=ff1769a4 href="#ref-PANA" value="PANA"
text node=43 x=207 baseline=1705 top=1690 w=47 h=19 size=16 bold=false italic=false color=ff263342 href="" value="], and ["
text node=45 x=254 baseline=1705 top=1690 w=71 h=19 size=16 bold=false italic=false color=ff1769a4 href="#ref-EAP-AKA" value="EAP-AKA"
text node=46 x=325 baseline=1705 top=1690 w=213 h=19 size=16 bold=false italic=false color=ff263342 href="" value="].  The purpose is to document"
rect x=103 y=1707 w=43 h=1 color=ff1769a4
rect x=162 y=1707 w=45 h=1 color=ff1769a4
rect x=254 y=1707 w=71 h=1 color=ff1769a4
text node=46 x=18 baseline=1729 top=1714 w=471 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   this KDF in a general way to facilitate adoption in future protocols"
text node=46 x=18 baseline=1753 top=1738 w=492 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   and applications, and to discourage the proliferation of multiple KDF"
text node=46 x=18 baseline=1777 top=1762 w=426 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   mechanisms.  It is not intended as a call to change existing"
text node=46 x=18 baseline=1801 top=1786 w=504 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   protocols and does not change or update existing specifications using"
text node=46 x=18 baseline=1825 top=1810 w=78 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   this KDF."
text node=46 x=18 baseline=1873 top=1858 w=480 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   HKDF follows the \"extract-then-expand\" paradigm, where the KDF"
text node=46 x=18 baseline=1897 top=1882 w=463 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   logically consists of two modules.  The first stage takes the input"
text node=46 x=18 baseline=1921 top=1906 w=480 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   keying material and \"extracts\" from it a fixed-length pseudorandom"
text node=46 x=18 baseline=1945 top=1930 w=498 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   key K.  The second stage \"expands\" the key K into several additional"
text node=46 x=18 baseline=1969 top=1954 w=324 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   pseudorandom keys (the output of the KDF)."
text node=46 x=18 baseline=2017 top=2002 w=466 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   In many applications, the input keying material is not necessarily"
text node=46 x=18 baseline=2041 top=2026 w=440 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   distributed uniformly, and the attacker may have some partial"
text node=46 x=18 baseline=2065 top=2050 w=512 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   knowledge about it (for example, a Diffie-Hellman value computed by a"
text node=46 x=18 baseline=2089 top=2074 w=449 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   key exchange protocol) or even partial control of it (as in some"
text node=46 x=18 baseline=2113 top=2098 w=451 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   entropy-gathering applications).  Thus, the goal of the \"extract\""
text node=46 x=18 baseline=2137 top=2122 w=485 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   stage is to \"concentrate\" the possibly dispersed entropy of the input"
text node=46 x=18 baseline=2161 top=2146 w=409 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   keying material into a short, but cryptographically strong,"
text node=46 x=18 baseline=2185 top=2170 w=501 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   pseudorandom key.  In some applications, the input may already be a"
text node=46 x=18 baseline=2209 top=2194 w=476 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   good pseudorandom key; in these cases, the \"extract\" stage is not"
text node=46 x=18 baseline=2233 top=2218 w=385 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   necessary, and the \"expand\" part can be used alone."
text node=46 x=18 baseline=2281 top=2266 w=482 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   The second stage \"expands\" the pseudorandom key to the desired"
text node=46 x=18 baseline=2305 top=2290 w=465 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   length; the number and lengths of the output keys depend on the"
text node=46 x=18 baseline=2329 top=2314 w=464 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   specific cryptographic algorithms for which the keys are needed."
text node=46 x=18 baseline=2377 top=2362 w=478 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   Note that some existing KDF specifications, such as NIST Special"
text node=46 x=18 baseline=2401 top=2386 w=165 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   Publication 800-56A ["
text node=48 x=183 baseline=2401 top=2386 w=61 h=19 size=16 bold=false italic=false color=ff1769a4 href="#ref-800-56A" value="800-56A"
text node=49 x=244 baseline=2401 top=2386 w=254 h=19 size=16 bold=false italic=false color=ff263342 href="" value="], NIST Special Publication 800-108"
rect x=183 y=2403 w=61 h=1 color=ff1769a4
text node=49 x=18 baseline=2425 top=2410 w=16 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   ["
text node=51 x=34 baseline=2425 top=2410 w=59 h=19 size=16 bold=false italic=false color=ff1769a4 href="#ref-800-108" value="800-108"
text node=52 x=93 baseline=2425 top=2410 w=243 h=19 size=16 bold=false italic=false color=ff263342 href="" value="] and IEEE Standard 1363a-2004 ["
text node=54 x=336 baseline=2425 top=2410 w=45 h=19 size=16 bold=false italic=false color=ff1769a4 href="#ref-1363a" value="1363a"
text node=55 x=381 baseline=2425 top=2410 w=151 h=19 size=16 bold=false italic=false color=ff263342 href="" value="], either only consider"
rect x=34 y=2427 w=59 h=1 color=ff1769a4
rect x=336 y=2427 w=45 h=1 color=ff1769a4
text node=55 x=18 baseline=2449 top=2434 w=511 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   the second stage (expanding a pseudorandom key), or do not explicitly"
text node=55 x=18 baseline=2473 top=2458 w=443 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   differentiate between the \"extract\" and \"expand\" stages, often"
text node=55 x=18 baseline=2497 top=2482 w=471 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   resulting in design shortcomings.  The goal of this specification is"
text node=55 x=18 baseline=2521 top=2506 w=525 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   to accommodate a wide range of KDF requirements while minimizing the"
text node=55 x=18 baseline=2545 top=2530 w=488 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   assumptions about the underlying hash function.  The \"extract-then-"
text node=55 x=18 baseline=2569 top=2554 w=347 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   expand\" paradigm supports well this goal (see ["
text node=57 x=365 baseline=2569 top=2554 w=91 h=19 size=16 bold=false italic=false color=ff1769a4 href="#ref-HKDF-paper" value="HKDF-paper"
text node=58 x=456 baseline=2569 top=2554 w=66 h=19 size=16 bold=false italic=false color=ff263342 href="" value="] for more"
rect x=365 y=2571 w=91 h=1 color=ff1769a4
text node=58 x=18 baseline=2593 top=2578 w=288 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   information about the design rationale)."
text node=60 x=18 baseline=2689 top=2674 w=427 h=19 size=16 bold=false italic=false color=ff263342 href="" value="Krawczyk & Eronen             Informational                     [Page 2]"
rect x=0 y=2748 w=988 h=1 color=ffd8e0e7
rect x=0 y=2749 w=988 h=1 color=ffd8e0e7
rect x=0 y=2748 w=1 h=2 color=ffd8e0e7
rect x=987 y=2748 w=1 h=2 color=ffd8e0e7
rect x=0 y=2768 w=988 h=1376 color=fff1f5f7
text node=68 x=18 baseline=2825 top=2810 w=74 h=19 size=16 bold=false italic=false color=ff1769a4 href="./rfc5869" value="RFC 5869"
text node=69 x=92 baseline=2825 top=2810 w=392 h=19 size=16 bold=false italic=false color=ff263342 href="" value="                 Extract-and-Expand HKDF                May 2010"
rect x=18 y=2827 w=74 h=1 color=ff1769a4
text node=73 x=18 baseline=2897 top=2882 w=9 h=19 size=16 bold=false italic=false color=ff1769a4 href="#section-2" value="2"
text node=74 x=27 baseline=2897 top=2882 w=343 h=19 size=16 bold=false italic=false color=ff263342 href="" value=".  HMAC-based Key Derivation Function (HKDF)"
rect x=18 y=2899 w=9 h=1 color=ff1769a4
text node=78 x=18 baseline=2945 top=2930 w=22 h=19 size=16 bold=false italic=false color=ff1769a4 href="#section-2.1" value="2.1"
text node=79 x=40 baseline=2945 top=2930 w=72 h=19 size=16 bold=false italic=false color=ff263342 href="" value=".  Notation"
rect x=18 y=2947 w=22 h=1 color=ff1769a4
text node=80 x=18 baseline=2993 top=2978 w=310 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   HMAC-Hash denotes the HMAC function ["
text node=82 x=328 baseline=2993 top=2978 w=48 h=19 size=16 bold=false italic=false color=ff1769a4 href="#ref-HMAC" value="HMAC"
text node=83 x=376 baseline=2993 top=2978 w=162 h=19 size=16 bold=false italic=false color=ff263342 href="" value="] instantiated with hash"
rect x=328 y=2995 w=48 h=1 color=ff1769a4
text node=83 x=18 baseline=3017 top=3002 w=485 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   function 'Hash'.  HMAC always has two arguments: the first is a key"
text node=83 x=18 baseline=3041 top=3026 w=454 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   and the second an input (or message).  (Note that in the extract"
text node=83 x=18 baseline=3065 top=3050 w=444 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   step, 'IKM' is used as the HMAC input, not as the HMAC key.)"
text node=83 x=18 baseline=3113 top=3098 w=544 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   When the message is composed of several elements we use concatenation"
text node=83 x=18 baseline=3137 top=3122 w=481 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   (denoted |) in the second argument; for example, HMAC(K, elem1 |"
text node=83 x=18 baseline=3161 top=3146 w=121 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   elem2 | elem3)."
text node=83 x=18 baseline=3209 top=3194 w=574 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   The key words \"MUST\", \"MUST NOT\", \"REQUIRED\", \"SHALL\", \"SHALL NOT\","
text node=83 x=18 baseline=3233 top=3218 w=602 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   \"SHOULD\", \"SHOULD NOT\", \"RECOMMENDED\", \"MAY\", and \"OPTIONAL\" in this"
text node=83 x=18 baseline=3257 top=3242 w=348 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   document are to be interpreted as described in ["
text node=85 x=366 baseline=3257 top=3242 w=95 h=19 size=16 bold=false italic=false color=ff1769a4 href="#ref-KEYWORDS" value="KEYWORDS"
text node=86 x=461 baseline=3257 top=3242 w=8 h=19 size=16 bold=false italic=false color=ff263342 href="" value="]."
rect x=366 y=3259 w=95 h=1 color=ff1769a4
text node=89 x=18 baseline=3305 top=3290 w=22 h=19 size=16 bold=false italic=false color=ff1769a4 href="#section-2.2" value="2.2"
text node=90 x=40 baseline=3305 top=3290 w=115 h=19 size=16 bold=false italic=false color=ff263342 href="" value=".  Step 1: Extract"
rect x=18 y=3307 w=22 h=1 color=ff1769a4
text node=91 x=18 baseline=3353 top=3338 w=238 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   HKDF-Extract(salt, IKM) -> PRK"
text node=91 x=18 baseline=3401 top=3386 w=71 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   Options:"
text node=91 x=18 baseline=3425 top=3410 w=441 h=19 size=16 bold=false italic=false color=ff263342 href="" value="      Hash     a hash function; HashLen denotes the length of the"
text node=91 x=18 baseline=3449 top=3434 w=266 h=19 size=16 bold=false italic=false color=ff263342 href="" value="               hash function output in octets"
text node=91 x=18 baseline=3497 top=3482 w=59 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   Inputs:"
text node=91 x=18 baseline=3521 top=3506 w=405 h=19 size=16 bold=false italic=false color=ff263342 href="" value="      salt     optional salt value (a non-secret random value);"
text node=91 x=18 baseline=3545 top=3530 w=423 h=19 size=16 bold=false italic=false color=ff263342 href="" value="               if not provided, it is set to a string of HashLen zeros."
text node=91 x=18 baseline=3569 top=3554 w=223 h=19 size=16 bold=false italic=false color=ff263342 href="" value="      IKM      input keying material"
text node=91 x=18 baseline=3617 top=3602 w=63 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   Output:"
text node=91 x=18 baseline=3641 top=3626 w=373 h=19 size=16 bold=false italic=false color=ff263342 href="" value="      PRK      a pseudorandom key (of HashLen octets)"
text node=91 x=18 baseline=3689 top=3674 w=298 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   The output PRK is calculated as follows:"
text node=91 x=18 baseline=3737 top=3722 w=225 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   PRK = HMAC-Hash(salt, IKM)"
text node=94 x=18 baseline=3785 top=3770 w=22 h=19 size=16 bold=false italic=false color=ff1769a4 href="#section-2.3" value="2.3"
text node=95 x=40 baseline=3785 top=3770 w=121 h=19 size=16 bold=false italic=false color=ff263342 href="" value=".  Step 2: Expand"
rect x=18 y=3787 w=22 h=1 color=ff1769a4
text node=96 x=18 baseline=3833 top=3818 w=270 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   HKDF-Expand(PRK, info, L) -> OKM"
text node=96 x=18 baseline=3881 top=3866 w=71 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   Options:"
text node=96 x=18 baseline=3905 top=3890 w=441 h=19 size=16 bold=false italic=false color=ff263342 href="" value="      Hash     a hash function; HashLen denotes the length of the"
text node=96 x=18 baseline=3929 top=3914 w=266 h=19 size=16 bold=false italic=false color=ff263342 href="" value="               hash function output in octets"
text node=98 x=18 baseline=4121 top=4106 w=427 h=19 size=16 bold=false italic=false color=ff263342 href="" value="Krawczyk & Eronen             Informational                     [Page 3]"
rect x=0 y=4180 w=988 h=1 color=ffd8e0e7
rect x=0 y=4181 w=988 h=1 color=ffd8e0e7
rect x=0 y=4180 w=1 h=2 color=ffd8e0e7
rect x=987 y=4180 w=1 h=2 color=ffd8e0e7
rect x=0 y=4200 w=988 h=1376 color=fff1f5f7
text node=106 x=18 baseline=4257 top=4242 w=74 h=19 size=16 bold=false italic=false color=ff1769a4 href="./rfc5869" value="RFC 5869"
text node=107 x=92 baseline=4257 top=4242 w=392 h=19 size=16 bold=false italic=false color=ff263342 href="" value="                 Extract-and-Expand HKDF                May 2010"
rect x=18 y=4259 w=74 h=1 color=ff1769a4
text node=108 x=18 baseline=4329 top=4314 w=59 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   Inputs:"
text node=108 x=18 baseline=4353 top=4338 w=418 h=19 size=16 bold=false italic=false color=ff263342 href="" value="      PRK      a pseudorandom key of at least HashLen octets"
text node=108 x=18 baseline=4377 top=4362 w=345 h=19 size=16 bold=false italic=false color=ff263342 href="" value="               (usually, the output from the extract step)"
text node=108 x=18 baseline=4401 top=4386 w=436 h=19 size=16 bold=false italic=false color=ff263342 href="" value="      info     optional context and application specific information"
text node=108 x=18 baseline=4425 top=4410 w=258 h=19 size=16 bold=false italic=false color=ff263342 href="" value="               (can be a zero-length string)"
text node=108 x=18 baseline=4449 top=4434 w=349 h=19 size=16 bold=false italic=false color=ff263342 href="" value="      L        length of output keying material in octets"
text node=108 x=18 baseline=4473 top=4458 w=190 h=19 size=16 bold=false italic=false color=ff263342 href="" value="               (<= 255*HashLen)"
text node=108 x=18 baseline=4521 top=4506 w=63 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   Output:"
text node=108 x=18 baseline=4545 top=4530 w=326 h=19 size=16 bold=false italic=false color=ff263342 href="" value="      OKM      output keying material (of L octets)"
text node=108 x=18 baseline=4593 top=4578 w=300 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   The output OKM is calculated as follows:"
text node=108 x=18 baseline=4641 top=4626 w=154 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   N = ceil(L/HashLen)"
text node=108 x=18 baseline=4665 top=4650 w=218 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   T = T(1) | T(2) | T(3) | ... | T(N)"
text node=108 x=18 baseline=4689 top=4674 w=180 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   OKM = first L octets of T"
text node=108 x=18 baseline=4737 top=4722 w=60 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   where:"
text node=108 x=18 baseline=4761 top=4746 w=237 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   T(0) = empty string (zero length)"
text node=108 x=18 baseline=4785 top=4770 w=315 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   T(1) = HMAC-Hash(PRK, T(0) | info | 0x01)"
text node=108 x=18 baseline=4809 top=4794 w=315 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   T(2) = HMAC-Hash(PRK, T(1) | info | 0x02)"
text node=108 x=18 baseline=4833 top=4818 w=315 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   T(3) = HMAC-Hash(PRK, T(2) | info | 0x03)"
text node=108 x=18 baseline=4857 top=4842 w=24 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   ..."
text node=108 x=18 baseline=4905 top=4890 w=443 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   (where the constant concatenated to the end of each T(n) is a"
text node=108 x=18 baseline=4929 top=4914 w=102 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   single octet.)"
text node=111 x=18 baseline=4977 top=4962 w=9 h=19 size=16 bold=false italic=false color=ff1769a4 href="#section-3" value="3"
text node=112 x=27 baseline=4977 top=4962 w=166 h=19 size=16 bold=false italic=false color=ff263342 href="" value=".  Notes to HKDF Users"
rect x=18 y=4979 w=9 h=1 color=ff1769a4
text node=113 x=18 baseline=5025 top=5010 w=475 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   This section contains a set of guiding principles regarding the use"
text node=113 x=18 baseline=5049 top=5034 w=523 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   of HKDF.  A much more extensive account of such principles and design"
text node=113 x=18 baseline=5073 top=5058 w=195 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   rationale can be found in ["
text node=115 x=213 baseline=5073 top=5058 w=91 h=19 size=16 bold=false italic=false color=ff1769a4 href="#ref-HKDF-paper" value="HKDF-paper"
text node=116 x=304 baseline=5073 top=5058 w=8 h=19 size=16 bold=false italic=false color=ff263342 href="" value="]."
rect x=213 y=5075 w=91 h=1 color=ff1769a4
text node=119 x=18 baseline=5121 top=5106 w=22 h=19 size=16 bold=false italic=false color=ff1769a4 href="#section-3.1" value="3.1"
text node=120 x=40 baseline=5121 top=5106 w=156 h=19 size=16 bold=false italic=false color=ff263342 href="" value=".  To Salt or not to Salt"
rect x=18 y=5123 w=22 h=1 color=ff1769a4
text node=121 x=18 baseline=5169 top=5154 w=470 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   HKDF is defined to operate with and without random salt.  This is"
text node=121 x=18 baseline=5193 top=5178 w=507 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   done to accommodate applications where a salt value is not available."
text node=121 x=18 baseline=5217 top=5202 w=457 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   We stress, however, that the use of salt adds significantly to the"
text node=121 x=18 baseline=5241 top=5226 w=518 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   strength of HKDF, ensuring independence between different uses of the"
text node=121 x=18 baseline=5265 top=5250 w=456 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   hash function, supporting \"source-independent\" extraction, and"
text node=121 x=18 baseline=5289 top=5274 w=457 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   strengthening the analytical results that back the HKDF design."
text node=121 x=18 baseline=5337 top=5322 w=485 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   Random salt differs fundamentally from the initial keying material in"
text node=121 x=18 baseline=5361 top=5346 w=483 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   two ways: it is non-secret and can be re-used.  As such, salt values"
text node=121 x=18 baseline=5385 top=5370 w=483 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   are available to many applications.  For example, a pseudorandom"
text node=121 x=18 baseline=5409 top=5394 w=470 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   number generator (PRNG) that continuously produces outputs by"
text node=121 x=18 baseline=5433 top=5418 w=493 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   applying HKDF to renewable pools of entropy (e.g., sampled system"
text node=121 x=18 baseline=5457 top=5442 w=461 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   events) can fix a salt value and use it for multiple applications of"
text node=123 x=18 baseline=5553 top=5538 w=427 h=19 size=16 bold=false italic=false color=ff263342 href="" value="Krawczyk & Eronen             Informational                     [Page 4]"
rect x=0 y=5612 w=988 h=1 color=ffd8e0e7
rect x=0 y=5613 w=988 h=1 color=ffd8e0e7
rect x=0 y=5612 w=1 h=2 color=ffd8e0e7
rect x=987 y=5612 w=1 h=2 color=ffd8e0e7
rect x=0 y=5632 w=988 h=1376 color=fff1f5f7
text node=131 x=18 baseline=5689 top=5674 w=74 h=19 size=16 bold=false italic=false color=ff1769a4 href="./rfc5869" value="RFC 5869"
text node=132 x=92 baseline=5689 top=5674 w=392 h=19 size=16 bold=false italic=false color=ff263342 href="" value="                 Extract-and-Expand HKDF                May 2010"
rect x=18 y=5691 w=74 h=1 color=ff1769a4
text node=133 x=18 baseline=5761 top=5746 w=428 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   HKDF without having to protect the secrecy of the salt.  In a"
text node=133 x=18 baseline=5785 top=5770 w=456 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   different application domain, a key agreement protocol deriving"
text node=133 x=18 baseline=5809 top=5794 w=493 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   cryptographic keys from a Diffie-Hellman exchange can derive a salt"
text node=133 x=18 baseline=5833 top=5818 w=468 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   value from public nonces exchanged and authenticated between"
text node=133 x=18 baseline=5857 top=5842 w=452 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   communicating parties as part of the key agreement (this is the"
text node=133 x=18 baseline=5881 top=5866 w=147 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   approach taken in ["
text node=135 x=165 baseline=5881 top=5866 w=43 h=19 size=16 bold=false italic=false color=ff1769a4 href="#ref-IKEv2" value="IKEv2"
text node=136 x=208 baseline=5881 top=5866 w=13 h=19 size=16 bold=false italic=false color=ff263342 href="" value="])."
rect x=165 y=5883 w=43 h=1 color=ff1769a4
text node=136 x=18 baseline=5929 top=5914 w=473 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   Ideally, the salt value is a random (or pseudorandom) string of the"
text node=136 x=18 baseline=5953 top=5938 w=465 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   length HashLen.  Yet, even a salt value of less quality (shorter in"
text node=136 x=18 baseline=5977 top=5962 w=399 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   size or with limited entropy) may still make a significant"
text node=136 x=18 baseline=6001 top=5986 w=478 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   contribution to the security of the output keying material; designers"
text node=136 x=18 baseline=6025 top=6010 w=469 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   of applications are therefore encouraged to provide salt values to"
text node=136 x=18 baseline=6049 top=6034 w=409 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   HKDF if such values can be obtained by the application."
text node=136 x=18 baseline=6097 top=6082 w=390 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   It is worth noting that, while not the typical case, some"
text node=136 x=18 baseline=6121 top=6106 w=484 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   applications may even have a secret salt value available for use; in"
text node=136 x=18 baseline=6145 top=6130 w=505 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   such a case, HKDF provides an even stronger security guarantee.  An"
text node=136 x=18 baseline=6169 top=6154 w=471 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   example of such application is IKEv1 in its \"public-key encryption"
text node=136 x=18 baseline=6193 top=6178 w=496 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   mode\", where the \"salt\" to the extractor is computed from nonces that"
text node=136 x=18 baseline=6217 top=6202 w=466 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   are secret; similarly, the pre-shared mode of IKEv1 uses a secret"
text node=136 x=18 baseline=6241 top=6226 w=269 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   salt derived from the pre-shared key."
text node=139 x=18 baseline=6289 top=6274 w=22 h=19 size=16 bold=false italic=false color=ff1769a4 href="#section-3.2" value="3.2"
text node=140 x=40 baseline=6289 top=6274 w=181 h=19 size=16 bold=false italic=false color=ff263342 href="" value=".  The 'info' Input to HKDF"
rect x=18 y=6291 w=22 h=1 color=ff1769a4
text node=141 x=18 baseline=6337 top=6322 w=445 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   While the 'info' value is optional in the definition of HKDF, it is"
text node=141 x=18 baseline=6361 top=6346 w=462 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   often of great importance in applications.  Its main objective is to"
text node=141 x=18 baseline=6385 top=6370 w=465 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   bind the derived key material to application- and context-specific"
text node=141 x=18 baseline=6409 top=6394 w=458 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   information.  For example, 'info' may contain a protocol number,"
text node=141 x=18 baseline=6433 top=6418 w=432 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   algorithm identifiers, user identities, etc.  In particular, it may"
text node=141 x=18 baseline=6457 top=6442 w=446 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   prevent the derivation of the same keying material for different"
text node=141 x=18 baseline=6481 top=6466 w=469 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   contexts (when the same input key material (IKM) is used in such"
text node=141 x=18 baseline=6505 top=6490 w=467 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   different contexts).  It may also accommodate additional inputs to"
text node=141 x=18 baseline=6529 top=6514 w=481 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   the key expansion part, if so desired (e.g., an application may want"
text node=141 x=18 baseline=6553 top=6538 w=455 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   to bind the key material to its length L, thus making L part of the"
text node=141 x=18 baseline=6577 top=6562 w=428 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   'info' field).  There is one technical requirement from 'info': it"
text node=141 x=18 baseline=6601 top=6586 w=426 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   should be independent of the input key material value IKM."
text node=144 x=18 baseline=6649 top=6634 w=22 h=19 size=16 bold=false italic=false color=ff1769a4 href="#section-3.3" value="3.3"
text node=145 x=40 baseline=6649 top=6634 w=164 h=19 size=16 bold=false italic=false color=ff263342 href="" value=".  To Skip or not to Skip"
rect x=18 y=6651 w=22 h=1 color=ff1769a4
text node=146 x=18 baseline=6697 top=6682 w=462 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   In some applications, the input key material IKM may already be"
text node=146 x=18 baseline=6721 top=6706 w=498 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   present as a cryptographically strong key (for example, the premaster"
text node=146 x=18 baseline=6745 top=6730 w=478 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   secret in TLS RSA cipher suites would be a pseudorandom string,"
text node=146 x=18 baseline=6769 top=6754 w=432 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   except for the first two octets).  In this case, one can skip the"
text node=146 x=18 baseline=6793 top=6778 w=503 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   extract part and use IKM directly to key HMAC in the expand step.  On"
text node=146 x=18 baseline=6817 top=6802 w=456 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   the other hand, applications may still use the extract part for the"
text node=146 x=18 baseline=6841 top=6826 w=454 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   sake of compatibility with the general case.  In particular, if IKM"
text node=146 x=18 baseline=6865 top=6850 w=515 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   is random (or pseudorandom) but longer than an HMAC key, the extract"
text node=146 x=18 baseline=6889 top=6874 w=489 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   step can serve to output a suitable HMAC key (in the case of HMAC"
text node=148 x=18 baseline=6985 top=6970 w=427 h=19 size=16 bold=false italic=false color=ff263342 href="" value="Krawczyk & Eronen             Informational                     [Page 5]"
rect x=0 y=7044 w=988 h=1 color=ffd8e0e7
rect x=0 y=7045 w=988 h=1 color=ffd8e0e7
rect x=0 y=7044 w=1 h=2 color=ffd8e0e7
rect x=987 y=7044 w=1 h=2 color=ffd8e0e7
rect x=0 y=7064 w=988 h=1376 color=fff1f5f7
text node=156 x=18 baseline=7121 top=7106 w=74 h=19 size=16 bold=false italic=false color=ff1769a4 href="./rfc5869" value="RFC 5869"
text node=157 x=92 baseline=7121 top=7106 w=392 h=19 size=16 bold=false italic=false color=ff263342 href="" value="                 Extract-and-Expand HKDF                May 2010"
rect x=18 y=7123 w=74 h=1 color=ff1769a4
text node=158 x=18 baseline=7193 top=7178 w=442 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   this shortening via the extractor is not strictly necessary since"
text node=158 x=18 baseline=7217 top=7202 w=485 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   HMAC is defined to work with long keys too).  Note, however, that if"
text node=158 x=18 baseline=7241 top=7226 w=480 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   the IKM is a Diffie-Hellman value, as in the case of TLS with Diffie-"
text node=158 x=18 baseline=7265 top=7250 w=534 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   Hellman, then the extract part SHOULD NOT be skipped.  Doing so would"
text node=158 x=18 baseline=7289 top=7274 w=475 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   result in using the Diffie-Hellman value g^{xy} itself (which is NOT"
text node=158 x=18 baseline=7313 top=7298 w=517 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   a uniformly random or pseudorandom string) as the key PRK for HMAC."
text node=158 x=18 baseline=7337 top=7322 w=467 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   Instead, HKDF should apply the extract step to g^{xy} (preferably"
text node=158 x=18 baseline=7361 top=7346 w=496 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   with a salt value) and use the resultant PRK as a key to HMAC in the"
text node=158 x=18 baseline=7385 top=7370 w=121 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   expansion part."
text node=158 x=18 baseline=7433 top=7418 w=492 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   In the case where the amount of required key bits, L, is no more than"
text node=158 x=18 baseline=7457 top=7442 w=497 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   HashLen, one could use PRK directly as the OKM.  This, however, is"
text node=158 x=18 baseline=7481 top=7466 w=528 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   NOT RECOMMENDED, especially because it would omit the use of 'info'"
text node=158 x=18 baseline=7505 top=7490 w=461 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   as part of the derivation process (and adding 'info' as an input to"
text node=158 x=18 baseline=7529 top=7514 w=286 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   the extract step is not advisable -- see ["
text node=160 x=304 baseline=7529 top=7514 w=91 h=19 size=16 bold=false italic=false color=ff1769a4 href="#ref-HKDF-paper" value="HKDF-paper"
text node=161 x=395 baseline=7529 top=7514 w=13 h=19 size=16 bold=false italic=false color=ff263342 href="" value="])."
rect x=304 y=7531 w=91 h=1 color=ff1769a4
text node=164 x=18 baseline=7577 top=7562 w=22 h=19 size=16 bold=false italic=false color=ff1769a4 href="#section-3.4" value="3.4"
text node=165 x=40 baseline=7577 top=7562 w=201 h=19 size=16 bold=false italic=false color=ff263342 href="" value=".  The Role of Independence"
rect x=18 y=7579 w=22 h=1 color=ff1769a4
text node=166 x=18 baseline=7625 top=7610 w=454 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   The analysis of key derivation functions assumes that the input"
text node=166 x=18 baseline=7649 top=7634 w=521 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   keying material (IKM) comes from some source modeled as a probability"
text node=166 x=18 baseline=7673 top=7658 w=435 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   distribution over bit streams of a certain length (e.g., streams"
text node=166 x=18 baseline=7697 top=7682 w=467 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   produced by an entropy pool, values derived from Diffie-Hellman"
text node=166 x=18 baseline=7721 top=7706 w=496 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   exponents chosen at random, etc.); each instance of IKM is a sample"
text node=166 x=18 baseline=7745 top=7730 w=461 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   from that distribution.  A major goal of key derivation functions is"
text node=166 x=18 baseline=7769 top=7754 w=508 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   to ensure that, when applying the KDF to any two values IKM and IKM'"
text node=166 x=18 baseline=7793 top=7778 w=493 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   sampled from the (same) source distribution, the resultant keys OKM"
text node=166 x=18 baseline=7817 top=7802 w=483 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   and OKM' are essentially independent of each other (in a statistical"
text node=166 x=18 baseline=7841 top=7826 w=469 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   or computational sense).  To achieve this goal, it is important that"
text node=166 x=18 baseline=7865 top=7850 w=480 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   inputs to KDF are selected from appropriate input distributions and"
text node=166 x=18 baseline=7889 top=7874 w=492 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   also that inputs are chosen independently of each other (technically,"
text node=166 x=18 baseline=7913 top=7898 w=472 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   it is necessary that each sample will have sufficient entropy, even"
text node=166 x=18 baseline=7937 top=7922 w=310 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   when conditioned on other inputs to KDF)."
text node=166 x=18 baseline=7985 top=7970 w=488 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   Independence is also an important aspect of the salt value provided"
text node=166 x=18 baseline=8009 top=7994 w=465 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   to a KDF.  While there is no need to keep the salt secret, and the"
text node=166 x=18 baseline=8033 top=8018 w=491 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   same salt value can be used with multiple IKM values, it is assumed"
text node=166 x=18 baseline=8057 top=8042 w=457 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   that salt values are independent of the input keying material.  In"
text node=166 x=18 baseline=8081 top=8066 w=466 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   particular, an application needs to make sure that salt values are"
text node=166 x=18 baseline=8105 top=8090 w=490 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   not chosen or manipulated by an attacker.  As an example, consider"
text node=166 x=18 baseline=8129 top=8114 w=482 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   the case (as in IKE) where the salt is derived from nonces supplied"
text node=166 x=18 baseline=8153 top=8138 w=477 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   by the parties in a key exchange protocol.  Before the protocol can"
text node=166 x=18 baseline=8177 top=8162 w=495 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   use such salt to derive keys, it needs to make sure that these nonces"
text node=166 x=18 baseline=8201 top=8186 w=478 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   are authenticated as coming from the legitimate parties rather than"
text node=166 x=18 baseline=8225 top=8210 w=471 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   selected by the attacker (in IKE, for example this authentication is"
text node=166 x=18 baseline=8249 top=8234 w=450 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   an integral part of the authenticated Diffie-Hellman exchange)."
text node=168 x=18 baseline=8417 top=8402 w=427 h=19 size=16 bold=false italic=false color=ff263342 href="" value="Krawczyk & Eronen             Informational                     [Page 6]"
rect x=0 y=8476 w=988 h=1 color=ffd8e0e7
rect x=0 y=8477 w=988 h=1 color=ffd8e0e7
rect x=0 y=8476 w=1 h=2 color=ffd8e0e7
rect x=987 y=8476 w=1 h=2 color=ffd8e0e7
rect x=0 y=8496 w=988 h=1376 color=fff1f5f7
text node=176 x=18 baseline=8553 top=8538 w=74 h=19 size=16 bold=false italic=false color=ff1769a4 href="./rfc5869" value="RFC 5869"
text node=177 x=92 baseline=8553 top=8538 w=392 h=19 size=16 bold=false italic=false color=ff263342 href="" value="                 Extract-and-Expand HKDF                May 2010"
rect x=18 y=8555 w=74 h=1 color=ff1769a4
text node=181 x=18 baseline=8625 top=8610 w=9 h=19 size=16 bold=false italic=false color=ff1769a4 href="#section-4" value="4"
text node=182 x=27 baseline=8625 top=8610 w=166 h=19 size=16 bold=false italic=false color=ff263342 href="" value=".  Applications of HKDF"
rect x=18 y=8627 w=9 h=1 color=ff1769a4
text node=183 x=18 baseline=8673 top=8658 w=458 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   HKDF is intended for use in a wide variety of KDF applications."
text node=183 x=18 baseline=8697 top=8682 w=512 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   These include the building of pseudorandom generators from imperfect"
text node=183 x=18 baseline=8721 top=8706 w=505 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   sources of randomness (such as a physical random number generator"
text node=183 x=18 baseline=8745 top=8730 w=497 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   (RNG)); the generation of pseudorandomness out of weak sources of"
text node=183 x=18 baseline=8769 top=8754 w=478 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   randomness, such as entropy collected from system events, user's"
text node=183 x=18 baseline=8793 top=8778 w=480 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   keystrokes, etc.; the derivation of cryptographic keys from a shared"
text node=183 x=18 baseline=8817 top=8802 w=453 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   Diffie-Hellman value in a key-agreement protocol; derivation of"
text node=183 x=18 baseline=8841 top=8826 w=465 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   symmetric keys from a hybrid public-key encryption scheme; key"
text node=183 x=18 baseline=8865 top=8850 w=464 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   derivation for key-wrapping mechanisms; and more.  All of these"
text node=183 x=18 baseline=8889 top=8874 w=492 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   applications can benefit from the simplicity and multi-purpose nature"
text node=183 x=18 baseline=8913 top=8898 w=363 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   of HKDF, as well as from its analytical foundation."
text node=183 x=18 baseline=8961 top=8946 w=470 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   On the other hand, it is anticipated that some applications will not"
text node=183 x=18 baseline=8985 top=8970 w=502 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   be able to use HKDF \"as-is\" due to specific operational requirements,"
text node=183 x=18 baseline=9009 top=8994 w=405 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   or will be able to use it but without the full benefits of the"
text node=183 x=18 baseline=9033 top=9018 w=484 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   scheme.  One significant example is the derivation of cryptographic"
text node=183 x=18 baseline=9057 top=9042 w=483 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   keys from a source of low entropy, such as a user's password.  The"
text node=183 x=18 baseline=9081 top=9066 w=470 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   extract step in HKDF can concentrate existing entropy but cannot"
text node=183 x=18 baseline=9105 top=9090 w=500 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   amplify entropy.  In the case of password-based KDFs, a main goal is"
text node=183 x=18 baseline=9129 top=9114 w=480 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   to slow down dictionary attacks using two ingredients: a salt value,"
text node=183 x=18 baseline=9153 top=9138 w=496 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   and the intentional slowing of the key derivation computation.  HKDF"
text node=183 x=18 baseline=9177 top=9162 w=475 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   naturally accommodates the use of salt; however, a slowing down"
text node=183 x=18 baseline=9201 top=9186 w=480 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   mechanism is not part of this specification.  Applications interested"
text node=183 x=18 baseline=9225 top=9210 w=478 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   in a password-based KDF should consider whether, for example, ["
text node=185 x=496 baseline=9225 top=9210 w=54 h=19 size=16 bold=false italic=false color=ff1769a4 href="#ref-PKCS5" value="PKCS5"
text node=186 x=550 baseline=9225 top=9210 w=4 h=19 size=16 bold=false italic=false color=ff263342 href="" value="]"
rect x=496 y=9227 w=54 h=1 color=ff1769a4
text node=186 x=18 baseline=9249 top=9234 w=270 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   meets their needs better than HKDF."
text node=189 x=18 baseline=9297 top=9282 w=9 h=19 size=16 bold=false italic=false color=ff1769a4 href="#section-5" value="5"
text node=190 x=27 baseline=9297 top=9282 w=182 h=19 size=16 bold=false italic=false color=ff263342 href="" value=".  Security Considerations"
rect x=18 y=9299 w=9 h=1 color=ff1769a4
text node=191 x=18 baseline=9345 top=9330 w=415 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   In spite of the simplicity of HKDF, there are many security"
text node=191 x=18 baseline=9369 top=9354 w=484 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   considerations that have been taken into account in the design and"
text node=191 x=18 baseline=9393 top=9378 w=473 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   analysis of this construction.  An exposition of all of these aspects"
text node=191 x=18 baseline=9417 top=9402 w=397 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   is beyond the scope of this document.  Please refer to ["
text node=193 x=415 baseline=9417 top=9402 w=91 h=19 size=16 bold=false italic=false color=ff1769a4 href="#ref-HKDF-paper" value="HKDF-paper"
text node=194 x=506 baseline=9417 top=9402 w=4 h=19 size=16 bold=false italic=false color=ff263342 href="" value="]"
rect x=415 y=9419 w=91 h=1 color=ff1769a4
text node=194 x=18 baseline=9441 top=9426 w=466 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   for detailed information, including rationale for the design and for"
text node=194 x=18 baseline=9465 top=9450 w=208 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   the guidelines presented in "
text node=196 x=226 baseline=9465 top=9450 w=67 h=19 size=16 bold=false italic=false color=ff1769a4 href="#section-3" value="Section 3"
text node=197 x=293 baseline=9465 top=9450 w=4 h=19 size=16 bold=false italic=false color=ff263342 href="" value="."
rect x=226 y=9467 w=67 h=1 color=ff1769a4
text node=197 x=18 baseline=9513 top=9498 w=364 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   A major effort has been made in the above paper ["
text node=199 x=382 baseline=9513 top=9498 w=91 h=19 size=16 bold=false italic=false color=ff1769a4 href="#ref-HKDF-paper" value="HKDF-paper"
text node=200 x=473 baseline=9513 top=9498 w=21 h=19 size=16 bold=false italic=false color=ff263342 href="" value="] to"
rect x=382 y=9515 w=91 h=1 color=ff1769a4
text node=200 x=18 baseline=9537 top=9522 w=509 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   provide a cryptographic analysis of HKDF as a multi-purpose KDF that"
text node=200 x=18 baseline=9561 top=9546 w=439 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   exercises much care in the way it utilizes cryptographic hash"
text node=200 x=18 baseline=9585 top=9570 w=412 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   functions.  This is particularly important due to the limited"
text node=200 x=18 baseline=9609 top=9594 w=478 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   confidence we have in the strength of current hash functions.  This"
text node=200 x=18 baseline=9633 top=9618 w=448 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   analysis, however, does not imply the absolute security of any"
text node=200 x=18 baseline=9657 top=9642 w=506 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   scheme, and it depends heavily on the strength of the underlying hash"
text node=200 x=18 baseline=9681 top=9666 w=435 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   function and on modeling choices.  Yet, it serves as a strong"
text node=200 x=18 baseline=9705 top=9690 w=436 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   indication of the correct structure of the HKDF design and its"
text node=200 x=18 baseline=9729 top=9714 w=344 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   advantages over other common KDF schemes."
text node=202 x=18 baseline=9849 top=9834 w=427 h=19 size=16 bold=false italic=false color=ff263342 href="" value="Krawczyk & Eronen             Informational                     [Page 7]"
rect x=0 y=9908 w=988 h=1 color=ffd8e0e7
rect x=0 y=9909 w=988 h=1 color=ffd8e0e7
