text node=2 x=18 baseline=201 top=186 w=24 h=19 size=16 bold=false italic=false color=ff263342 href="" value="      "
text node=4 x=42 baseline=201 top=186 w=476 h=19 size=16 bold=false italic=false color=ff263342 href="" value="HMAC-based Extract-and-Expand Key Derivation Function (HKDF)"
text node=5 x=18 baseline=249 top=234 w=58 h=19 size=16 bold=false italic=false color=ff263342 href="" value="Abstract"
text node=5 x=18 baseline=297 top=282 w=526 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   This document specifies a simple Hashed Message Authentication Code"
text node=5 x=18 baseline=321 top=306 w=516 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   (HMAC)-based key derivation function (HKDF), which can be used as a"
text node=5 x=18 baseline=345 top=330 w=443 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   building block in various protocols and applications.  The key"
text node=5 x=18 baseline=369 top=354 w=458 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   derivation function (KDF) is intended to support a wide range of"
text node=5 x=18 baseline=393 top=378 w=455 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   applications and requirements, and is conservative in its use of"
text node=5 x=18 baseline=417 top=402 w=219 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   cryptographic hash functions."
text node=5 x=18 baseline=465 top=450 w=145 h=19 size=16 bold=false italic=false color=ff263342 href="" value="Status of This Memo"
text node=5 x=18 baseline=513 top=498 w=484 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   This document is not an Internet Standards Track specification; it is"
text node=5 x=18 baseline=537 top=522 w=274 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   published for informational purposes."
text node=5 x=18 baseline=585 top=570 w=478 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   This document is a product of the Internet Engineering Task Force"
text node=5 x=18 baseline=609 top=594 w=476 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   (IETF).  It represents the consensus of the IETF community.  It has"
text node=5 x=18 baseline=633 top=618 w=494 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   received public review and has been approved for publication by the"
text node=5 x=18 baseline=657 top=642 w=460 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   Internet Engineering Steering Group (IESG).  Not all documents"
text node=5 x=18 baseline=681 top=666 w=446 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   approved by the IESG are a candidate for any level of Internet"
text node=5 x=18 baseline=705 top=690 w=115 h=19 size=16 bold=false italic=false color=ff263342 href="" value="   Standard; see "
text node=7 x=133 baseline=705 top=690 w=162 h=19 size=16 bold=false italic=false color=ff1769a4 href="./rfc5741#section-2" value="Section 2 of RFC 5741"
text node=8 x=295 baseline=705 top=690 w=4 h=19 size=16 bold=false italic=false color=ff263342 href="" value="."
