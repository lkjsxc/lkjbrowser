text node=2 x=18 baseline=33 top=18 w=458 h=19 size=16 bold=false italic=false color=ff263342 href="" value="Internet Engineering Task Force (IETF)                       H. Krawczyk"
text node=2 x=18 baseline=57 top=42 w=444 h=19 size=16 bold=false italic=false color=ff263342 href="" value="Request for Comments: 5869                                  IBM Research"
text node=2 x=18 baseline=81 top=66 w=396 h=19 size=16 bold=false italic=false color=ff263342 href="" value="Category: Informational                                        P. Eronen"
text node=2 x=18 baseline=105 top=90 w=373 h=19 size=16 bold=false italic=false color=ff263342 href="" value="ISSN: 2070-1721                                                    Nokia"
