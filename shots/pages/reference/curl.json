      "display": "block",
      "float": "none",
      "position": "static"
    },
    {
      "tag": "P",
      "id": "",
      "classes": "",
      "text": "The reason why static libraries are much harder to deal with is that for them we do not get any help",
      "x": 0,
      "y": 8242.09375,
      "w": 1000,
      "h": 92,
      "font": "arial, helvetica, ariel, sans-serif",
