      "x": 0,
      "y": 6759.390625,
      "w": 1000,
      "h": 34,
      "font": "arial, helvetica, ariel, sans-serif",
      "fontSize": "30px",
      "display": "block",
      "float": "none",
      "position": "static"
    },
    {
      "tag": "P",
      "id": "",
      "classes": "",
      "text": "In the curl project we have decided not to attempt to keep this file updated (or even present) since",
      "x": 0,
      "y": 6818.28125,
      "w": 1000,
      "h": 69,
      "font": "arial, helvetica, ariel, sans-serif",
      "fontSize": "20px",
      "display": "block",
      "float": "none",
      "position": "static"
    },
    {
      "tag": "P",
      "id": "",
      "classes": "",
      "text": "Today, with many services performed over HTTPS, every operating system should come with a default CA",
      "x": 0,
      "y": 6907.28125,
      "w": 1000,
      "h": 69,
      "font": "arial, helvetica, ariel, sans-serif",
      "fontSize": "20px",
      "display": "block",
      "float": "none",
      "position": "static"
    },
    {
      "tag": "P",
      "id": "",
      "classes": "",
      "text": "If you want the most recent collection of CA certs that Mozilla Firefox uses, we recommend using our",
      "x": 0,
      "y": 6996.28125,
      "w": 1000,
      "h": 46,
      "font": "arial, helvetica, ariel, sans-serif",
      "fontSize": "20px",
      "display": "block",
      "float": "none",
      "position": "static"
    },
