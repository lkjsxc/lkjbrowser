      "display": "block",
      "float": "none",
      "position": "static"
    },
    {
      "tag": "P",
      "id": "",
      "classes": "",
      "text": "We strongly encourage you to submit changes and improvements directly as pull requests on GitHub.",
      "x": 0,
      "y": 7603.625,
