      "position": "static"
    },
    {
      "tag": "P",
      "id": "",
      "classes": "",
      "text": "There is no way to independently force an upgrade of the curl.exe that is part of Windows other than",
      "x": 0,
      "y": 8815.65625,
      "w": 1000,
      "h": 69,
      "font": "arial, helvetica, ariel, sans-serif",
      "fontSize": "20px",
      "display": "block",
      "float": "none",
      "position": "static"
    },
    {
      "tag": "P",
