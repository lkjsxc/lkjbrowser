// Accepted counterpart: finish the outer view-bearing temporary before entering the loop.
pub fn probe(bytes: &[u8]) -> usize {
    let valid = { match std::str::from_utf8(bytes) {
        Ok(_) => true, Err(_) => false,
    }};
    if valid { return bytes.len(); }
    let mut i = 0usize;
    while i < bytes.len() {
        match std::str::from_utf8(&bytes[i..i + 1usize]) {
            Ok(_) => { i += 1usize; continue; }
            Err(_) => {},
        }
        i += 1usize;
    }
    i
}
