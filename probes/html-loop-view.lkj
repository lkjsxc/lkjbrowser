// Expected E_BORROW on the pinned compiler. No String, mutation of bytes or live payload view is needed.
pub fn probe(bytes: &[u8]) -> usize {
    match std::str::from_utf8(bytes) {
        Ok(_) => bytes.len(),
        Err(_) => {
            let mut i = 0usize;
            while i < bytes.len() {
                match std::str::from_utf8(&bytes[i..i + 1usize]) {
                    Ok(_) => { i += 1usize; continue; }
                    Err(_) => {},
                }
                i += 1usize;
            }
            i
        },
    }
}
