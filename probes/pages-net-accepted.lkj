pub fn late()->usize{let value:String;value=String::new();value.len()}
pub fn collection(value:&str)->usize{
 let mut codings:Vec<String>=Vec::new();for part in value.split(','){codings.push(std::str::trim_ascii(part).to_ascii_lowercase());}
 let mut total=0usize;let mut i=codings.len();while i>0usize{i-=1usize;total+=codings[i].as_str().len();}total
}
pub fn parse()->i32{"42".to_string().as_str().parse::<i32>().unwrap()}
